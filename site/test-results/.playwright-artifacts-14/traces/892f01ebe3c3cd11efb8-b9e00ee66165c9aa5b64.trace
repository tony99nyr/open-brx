y 3, 8, 24, 25, 26, 27, 28, 35 · ally 31, 32, 34"],"\n",["TD",{},["CODE",{},"$HIR"]," fires, pools unchanged, no other frame."],"\n",["TD",{},"—"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"No registration"],"\n",["TD",{},"0, 39–45 (and 28/45 on protocol 5)"],"\n",["TD",{},"—"],"\n",["TD",{},"—"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n"]]],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-26 complete two-sided $SIR map; 2026-08-27 fn 23)"]],"\n",["SECTION",{"class":"blk blk-callout co-warn","data-type":"callout"},["ASIDE",{"class":"callout warn","role":"note","id":"support-functions-are-team-gated-in-firmware"},["STRONG",{"class":"co-title"},"Support functions are team-gated in firmware."],["P",{},"With ",["CODE",{},"$GSET"]," friendlyFire = 0, heals/armor/shield grants register ",["STRONG",{},"only from a same-team source"],", and damage registers only from another team. Set friendlyFire = 1 and everything lands from anyone. A medic gun enforces \"allies only\" with zero host logic."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §5; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (dual-polarity, FF table)"]]],"\n",["SECTION",{"class":"blk blk-diagram","data-type":"diagram"},["FIGURE",{"class":"fig fig-svg fig-pending","id":"DEV-07","style":"--ratio:16/9"},["DIV",{"class":"ph ph-svg","role":"img","aria-label":"Damage pipeline flow: [IR word: B,U,D,C] → [victim looks up $SIR(B,U)] → branch \"no row → dropped silently\" / \"row found\" → [function class: damage ×1 / ×1.25 / ×2 / AP / heal / armor / shield / status] → [×1.5 if C=1] → [team gate: FF=0 blocks same-team damage and enemy heals] → [drain shields → armor → HP] → [emit $HIR + $HP]. Use amber for the drop/gate branches."},["SPAN",{"class":"ph-id"},"DEV-07"],["SPAN",{"class":"ph-kind"},"diagram pending"]],["FIGCAPTION",{},"Damage pipeline: IR word (B,U,D,C) → victim ",["CODE",{},"$SIR[B,U]"]," → function multiplier → ×1.5 if crit → drain shields → armor → HP → emit ",["CODE",{},"$HIR"]," + ",["CODE",{},"$HP"],"."]],["P",{"class":"src"},["SPAN",{},"Source:"]," below"]],"\n",["SECTION",{"class":"blk blk-stat-row","data-type":"stat-row"},["UL",{"class":"stats"},["LI",{},["STRONG",{},"applied = magnitude × fn multiplier × (1.5 if crit)"],["SPAN",{},"— fn 1 ×1 · fn 36 ×1.25 · fn 37 ×2; crit stacks (fn 37 + crit = ×3). ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]]],["LI",{},["STRONG",{},"Drain order: shields → armor → HP."],["SPAN",{},"Armor absorbs 1:1 with no per-hit cap; overflow spills into HP (a sniper's 80 split exactly 70/10). ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]]],["LI",{},["STRONG",{},"Heals clamp"],["SPAN",{},"at the pool max — magnitude 200 is a fill, not a stack. ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]]],["LI",{},["STRONG",{},"No function is a damage-over-time."],["SPAN",{},"18 s watched after each status hit: no ticks. ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]]],["LI",{},["STRONG",{},"Dead guns accept no IR at all."],["SPAN",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]]]],["P",{"cla