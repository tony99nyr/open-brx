{"type":"frame-snapshot","snapshot":{"callId":"call@18","snapshotName":"before@call@18","pageId":"page@3af05e41b0a545703f163893f5108a7a","frameId":"frame@9c607e5353d9712f08e3594b004f0246","frameUrl":"http://localhost:4173/manual/dev/sir/","doctype":"html","html":["HTML",{"lang":"en","data-theme":""},[[7,24]],[[7,25]],["BODY",{"class":""},[[7,26]],[[7,28]],[[7,29]],[[7,65]],[[7,66]],["DIV",{"class":"layout has-side has-toc"},[[7,67]],[[7,284]],[[7,285]],["MAIN",{"id":"main","class":"main"},[[7,286]],[[7,301]],[[7,302]],["ARTICLE",{"class":"page"},[[7,303]],["HEADER",{"class":"page-head"},[[7,304]],[[2,0]],[[7,309]],[[7,311]],[[7,312]],["P",{"class":"meta"},[[7,317]],["SPAN",{"class":"lv"},[[7,318]],["TIME",{"datetime":"2026-08-27"},[[7,319]]]],[[7,323]]],[[7,325]],[[7,383]],[[7,384]]],[[7,386]],[[7,413]],[[7,414]],[[7,474]],[[7,475]],[[7,492]],[[7,493]],[[7,813]],[[7,814]],[[7,836]],[[7,837]],[[7,859]],[[7,860]],[[7,921]],[[7,922]],[[7,963]],[[7,964]]],[[7,966]]],[[7,968]],[[7,985]],[[7,986]]],[[7,988]],[[7,1010]],[[7,1011]],[[7,1019]],[[7,1020]],[[7,1021]]]],"viewport":{"width":1280,"height":900},"timestamp":50102.589,"wallTime":1787863202564,"collectionTime":0.5999999046325684,"resourceOverrides":[],"isMainFrame":true}}
