fied only"},["I",{"aria-hidden":"true"},"📐"],["SPAN",{},"spec"]]," Specified only"],["LI",{},["SPAN",{"class":"badge b-wip","title":"Under construction"},["I",{"aria-hidden":"true"},"🚧"],["SPAN",{},"under construction"]]," Under construction"]],["P",{},"Nothing unconfirmed is published — see ",["A",{"href":"/credits/"},"Credits & sourcing"],"."]],"\n"],"\n",["SECTION",{"class":"blk blk-callout co-info","data-type":"callout"},["ASIDE",{"class":"callout info","role":"note","id":"the-key-idea"},["STRONG",{"class":"co-title"},"The key idea."],["P",{},"An incoming IR word carries a 4-bit protocol (B) and a 2-bit subtype (U). The victim looks up the ",["CODE",{},"$SIR"]," row with that ",["CODE",{},"<protocol, subtype>"]," key; the row's ",["STRONG",{},"function"]," decides what the word's 8-bit magnitude is applied to — damage, heal, armor, shield, or a status. ",["STRONG",{},"No matching row → the hit is silently ignored."]," 16 × 4 = 64 addressable cells, all writable per game over BLE."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §5; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-ir-protocol.md","rel":"noopener"},"protocol/brx-ir-protocol.md"]]]],"\n",["SECTION",{"class":"blk blk-spec-sheet","data-type":"spec-sheet"},["H2",{"id":"format"},"Format:"],["P",{"class":"lead"},["CODE",{},"$SIR,<irProtocol>,<subtype>,<soundID>,<function>,<p5>,<p6>,<p7>,<p8>,*"]],["DL",{},["DT",{},["CODE",{},"<soundID>"]," plays ",["STRONG",{},"on the victim"]," when the row fires (",["CODE",{},"VA16"]," \"armor suit\", ",["CODE",{},"VA8C"]," \"shields online\", ",["CODE",{},"H29"]," stim-pack)."],["DD"],["DT",{},["CODE",{},"<p5>–<p8>"]," do ",["STRONG",{},"not"]," scale damage (",["CODE",{},"0,0,1"],", ",["CODE",{},"0,50,1"],", ",["CODE",{},"0,100,2,60"],", ",["CODE",{},"0,200,2,60"],", ",["CODE",{},"50,100,2,60"]," all landed exactly the magnitude)."],["DD"],["DT",{},"Max distinct IR recognitions per game: 14 (community figure)."],["DD"]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §5; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (clean negatives)"]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-text"},"# The stock 10-row table the official app sends (Team Arena):\n$SIR,0,0,,1,0,0,1,,*        standard weapons (AR, SMG, snipers, shotgun…) — plain damage\n$SIR,0,1,,36,0,0,1,,*       Force Rifle / Sniper Rifle — ×1.25 damage\n$SIR,0,3,,37,0,0,1,,*       AMR / Bolt Rifle / Burst Rifle — ×2 damage\n$SIR,1,0,H29,10,0,0,1,,*    respawn + add HP\n$SIR,2,1,VA8C,11,0,0,1,,*   add shields\n$SIR,3,0,VA16,13,0,0,1,,*   add armor\n$SIR,6,0,H02,1,0,90,1,40,*  Rail Gun\n$SIR,8,0,,38,0,0,1,,*       Charge Rifle\n$SIR,9,3,,24,10,0,,,*       Energy Launcher (fn 24 is a no-pool status — deals zero damage as shipped)\n$SIR,10,0,X13,1,0,100,2,60,* Rocket Launcher\n$SIR,11,0,VA2,28,0,0,1,,*   Tear gas\n$SIR,13,0,H50,… / 13,1,H57 / 13,3,H49   Energy Blade / Rifle Bash / War Hammer (melee)\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §5; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (shipped-table consequence)"]],"\n",["SECTION",{"class":"blk blk-data-table","data-type":"data-table"},["H2",{"id":"function-map-measured-at-magnitude-20-on-protocol-5-baseline"},"Function map (measured at magnitude 20 on protocol 5, baseline HP 4