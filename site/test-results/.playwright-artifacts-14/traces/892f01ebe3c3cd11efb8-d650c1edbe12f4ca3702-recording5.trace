"LI",{},["A",{"href":"/manual/dev/captures/"},"Captures — recording and decoding the official app"]]]]],"\n  ",["MAIN",{"id":"main","class":"main"},"\n    ",["NAV",{"class":"crumbs","aria-label":"Breadcrumb"},["A",{"href":"/"},"Home"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/"},"Manual"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/dev/"},"Developer reference"],["SPAN",{"class":"sep"},"/"],["SPAN",{"aria-current":"page"},"Getting started with brx-mcp"]],"\n    ",["ARTICLE",{"class":"page"},"\n",["HEADER",{"class":"page-head"},"\n",["H1",{},"Getting started with ",["CODE",{},"brx-mcp"]],"\n",["P",{"class":"subtitle"},"From ",["CODE",{},"pip install"]," to a live game in six commands — plus the MCP tools for driving a gun from an AI agent"],"\n",["P",{"class":"meta"},["SPAN",{"class":"lv"},"Last verified ",["TIME",{"datetime":"2026-08-27"},"2026-08-27"]],["A",{"class":"md-link","href":"/manual/dev/brx-mcp.md"},"View as Markdown"]],"\n",["DETAILS",{"class":"legend"},["SUMMARY",{},"What the badges mean"],["UL",{},["LI",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," Verified on our bench"],["LI",{},["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]," Official Battle Company docs"],["LI",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," Decoded from the Callsign app"],["LI",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]," Community-reported"],["LI",{},["SPAN",{"class":"badge b-software","title":"Built + software-tested"},["I",{"aria-hidden":"true"},"🧪"],["SPAN",{},"software"]]," Built + software-tested"],["LI",{},["SPAN",{"class":"badge b-spec","title":"Specified only"},["I",{"aria-hidden":"true"},"📐"],["SPAN",{},"spec"]]," Specified only"],["LI",{},["SPAN",{"class":"badge b-wip","title":"Under construction"},["I",{"aria-hidden":"true"},"🚧"],["SPAN",{},"under construction"]]," Under construction"]],["P",{},"Nothing unconfirmed is published — see ",["A",{"href":"/credits/"},"Credits & sourcing"],"."]],"\n"],"\n",["SECTION",{"class":"blk blk-callout co-info","data-type":"callout"},["ASIDE",{"class":"callout info","role":"note"},["P",{},["CODE",{},"brx-mcp"]," is the project's lab instrument: a pure-Python (",["CODE",{},"bleak"]," + ",["CODE",{},"mcp"],") CLI and MCP server that runs on ",["STRONG",{},"whichever machine owns the Bluetooth radio"]," — Windows, macOS or Linux. It enforces the known-safe list, refuses malformed frames, records every session, and has a ",["CODE",{},"panic"]," tool."],["P",{"class":"src"},["SPAN",{},"Source:"]," README.md (quickstart, Safety)"]]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-bash"},"# on the machine with the BLE radio (Windows PowerShell, macOS terminal, or Linux):\npython -m venv .venv && . .venv/bin/activate     # Windows: .venv\\Scripts\\activate\npip install -e ./mcp\n\n# first contact — no MCP client needed:\npython -m brx_mcp scan             # find taggers (Gen2/3 advertise the Nordic UART service)\npython -m brx_mcp identify <addr>  # $PING → generation check, firmware, host image\npython -m brx_mcp listen <addr>    # read-only live console: pull the trigger, watch $BUT/$HIR/$HP\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," README.md"]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-bash"},"# ...and now actually play. Your laptop drives the guns directly over BLE,\n# so everyone stays within BLE range of it (a room or a yard).\npython -m brx_mcp play tdm <addr1> <addr2> volume=69   # a real Team Deathmatch with live scoring\n#   modes: tdm ffa infection lms cs domination koth ctf extraction\n#   run `python -m brx_mcp` with no arguments for the full command list\n\n# no guns to hand? this needs no hardware at all:\npython -m brx_mcp game-sim tdm                         # narrated demo match in your terminal\n\n# read the USB device record (tagger on the Programing Port):\npython -m brx_mcp usb-query                            # QUERY over the Teensy serial console\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," README.md; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/mcp/brx_mcp/__main__.py","rel":"noopener"},"mcp/brx_mcp/__main__.py"]]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-bash"},"# register with Claude Code as an MCP server:\nclaude mcp add brx -- python -m brx_mcp\n# WSL2 has no Bluetooth — develop in WSL, run the server with Windows Python:\nclaude mcp add brx -- python.exe -m brx_mcp\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," README.md (Platform notes)"]],"\n",["SECTION",{"class":"blk blk-table","data-type":"table"},["H2",{"id":"cli-commands"},"CLI commands"],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"Command"],"\n",["TH",{},"What it does"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},["CODE",{},"scan"]," · ",["CODE",{},"identify <addr>"]," · ",["CODE",{},"listen <addr>"]," · ",["CODE",{},"probe <addr>"]],"\n",["TD",{},"Discover, check, watch, probe a single gun"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"startgame <addr>"]," · ",["CODE",{},"deathmatch <addr>"]," · ",["CODE",{},"arena <addr1> <addr2>"]," · ",["CODE",{},"fieldstart …"]],"\n",["TD",{},"Earlier single-purpose game drivers (the §7e sequence)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"play <mode> <addr…> [volume=69]"]],"\n",["TD",{},"Hosted match with live scoring; modes tdm ffa infection lms cs domination koth ctf extraction"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"game-sim <mode>"]," · ",["CODE",{},"extraction-sim"]],"\n",["TD",{},"Hardware-free narrated simulations"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"diag <addr>"]," · ",["CODE",{},"diagnose <addr>"]," · ",["CODE",{},"diag-game <addr>"]," · ",["CODE",{},"fleet"]],"\n",["TD",{},"Diagnostics, fleet battery/reachability sweep"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"usb-query [port]"]," · ",["CODE",{},"enroll"]," · ",["CODE",{},"armory"]," · ",["CODE",{},"rename"]," · ",["CODE",{},"reset"]],"\n",["TD",{},"USB device record, armory enrolment, persistent ",["CODE",{},"$NAME"],", reset"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"ir-capture"]," · ",["CODE",{},"ir-emit"]," · ",["CODE",{},"ir-range"]],"\n",["TD",{},"Drive the ESP32 IR transceiver rig"],"\n"],"\n"]]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/mcp/brx_mcp/__main__.py","rel":"noopener"},"mcp/brx_mcp/__main__.py"]," (dispatch table)"]],"\n",["SECTION",{"class":"blk blk-table","data-type":"table"},["H2",{"id":"mcp-tools-what-an-agent-can-call"},"MCP tools (what an agent can call)"],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"Tool"],"\n",["TH",{},"Purpose"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},["CODE",{},"scan(duration_s)"]," · ",["CODE",{},"identify(address)"]," · ",["CODE",{},"diagnostics(address)"]," · ",["CODE",{},"fleet_status(addresses)"]],"\n",["TD",{},"Discovery and health"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"connect(address, alias)"]," · ",["CODE",{},"disconnect(alias)"]," · ",["CODE",{},"list_connections()"]],"\n",["TD",{},"Session management"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"send(alias, command, confirm=False)"]," · ",["CODE",{},"send_batch(alias, commands, gap_ms=100)"]],"\n",["TD",{},"Write frames; anything outside the known-safe list needs ",["CODE",{},"confirm=True"]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"get_events(alias, since_seq)"]," · ",["CODE",{},"wait_for(alias, prefix, timeout_s)"]],"\n",["TD",{},"Read the buffered event stream / block on a message"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"session_log(alias, action, label)"]," · ",["CODE",{},"diff_captures(file_a, file_b)"]],"\n",["TD",{},"Record and diff sessions"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"panic(alias)"]],"\n",["TD",{},["CODE",{},"$CLEAR,*"]," then ",["CODE",{},"$SP,99,*"]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"parse_query_dump(text)"]],"\n",["TD",{},"Parse a USB ",["CODE",{},"QUERY"]," record"],"\n"],"\n",["TR",{},"\n",["TD",{},"Resources: ",["CODE",{},"protocol_doc"],", ",["CODE",{},"known_devices"],", ",["CODE",{},"capture"]],"\n",["TD",{},"The protocol reference, the device registry, capture files"],"\n"],"\n"]]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/mcp/brx_mcp/server.py","rel":"noopener"},"mcp/brx_mcp/server.py"]]],"\n",["SECTION",{"class":"blk blk-callout co-tip","data-type":"callout"},["ASIDE",{"class":"callout tip","role":"note","id":"platform-notes"},["STRONG",{"class":"co-title"},"Platform notes."],["P",{},"macOS: grant your terminal Bluetooth permission; CoreBluetooth reports per-machine ",["STRONG",{},"UUIDs instead of MAC addresses"],", so never pattern-match on address format and expect to re-scan per machine. Gen1 taggers use Bluetooth Classic — ",["CODE",{},"bleak"]," is BLE-only, so pair in the OS and use the serial port (guide todo). Captures and the device registry live in ",["CODE",{},"~/.brx-mcp/"],"."],["P",{"class":"src"},["SPAN",{},"Source:"]," README.md; CLAUDE.md; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/gotchas.md","rel":"noopener"},"docs/gotchas.md"]]]],"\n",["SECTION",{"class":"blk blk-steps","data-type":"steps"},["H2",{"id":"recommended-