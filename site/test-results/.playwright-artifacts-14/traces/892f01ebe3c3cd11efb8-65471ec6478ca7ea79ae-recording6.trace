{"type":"frame-snapshot","snapshot":{"callId":"call@264","snapshotName":"before@call@264","pageId":"page@f8e20c3a911a127999130205dc01e1a0","frameId":"frame@4705d4c7ed573e5edb14f2cfa947a907","frameUrl":"http://localhost:4173/manual/dev/captures/","doctype":"html","html":["HTML",{"lang":"en","data-theme":""},[[7,24]],[[7,25]],["BODY",{"class":""},[[7,26]],[[7,28]],[[7,29]],[[7,65]],[[7,66]],["DIV",{"class":"layout has-side has-toc"},[[7,67]],[[7,284]],[[7,285]],["MAIN",{"id":"main","class":"main"},[[7,286]],[[7,301]],[[7,302]],["ARTICLE",{"class":"page"},[[7,303]],["HEADER",{"class":"page-head"},[[7,304]],[[2,0]],[[7,307]],[[7,309]],[[7,310]],["P",{"class":"meta"},["SPAN",{"class":"lv"},[[7,311]],["TIME",{"datetime":"2026-08-27"},[[7,312]]]],[[7,316]]],[[7,318]],[[7,376]],[[7,377]]],[[7,379]],[[7,403]],[[7,404]],[[7,462]],[[7,463]],[[7,495]],[[7,496]],[[7,512]],[[7,513]],[[7,529]],[[7,530]],[[7,615]],[[7,616]],[[7,659]],[[7,660]],[[7,679]],[[7,680]]],[[7,682]]],[[7,684]],[[7,710]],[[7,711]]],[[7,713]],[[7,735]],[[7,736]],[[7,744]],[[7,745]],[[7,746]]]],"viewport":{"width":1280,"height":900},"timestamp":54885.144,"wallTime":1787863207346,"collectionTime":0.7000000476837158,"resourceOverrides":[],"isMainFrame":true}}
