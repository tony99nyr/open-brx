ounds over USB"]],["LI",{},["A",{"href":"/manual/sound/firmware/"},"Firmware updates & factory restore"]],["LI",{},["A",{"href":"/manual/sound/volume/"},"Volume"]]]],["DETAILS",{"class":"side-sec"},["SUMMARY",{},["SPAN",{"class":"num"},"05"]," Fix, mod & accessorise"],["UL",{},["LI",{},["A",{"href":"/manual/fix/"},"Overview"]],["LI",{},["A",{"href":"/manual/fix/diagnose/"},"Diagnose my tagger"]],["LI",{},["A",{"href":"/manual/fix/pairing/"},"Headset, pairing & Bluetooth"]],["LI",{},["A",{"href":"/manual/fix/hits-sound-battery/"},"Hits, sound & battery"]],["LI",{},["A",{"href":"/manual/fix/repairs/"},"Repairs"]],["LI",{},["A",{"href":"/manual/fix/mods/"},"Mods"]],["LI",{},["A",{"href":"/manual/fix/accessories/"},"Accessories"]],["LI",{},["A",{"href":"/manual/fix/community/"},"The community"]],["LI",{},["A",{"href":"/manual/fix/faq/"},"FAQ"]]]],["DETAILS",{"class":"side-sec","open":""},["SUMMARY",{},["SPAN",{"class":"num"},"06"]," Developer reference"],["UL",{},["LI",{},["A",{"href":"/manual/dev/"},"Overview"]],["LI",{},["A",{"href":"/manual/dev/transport/"},"Transport, framing & safety"]],["LI",{},["A",{"href":"/manual/dev/commands/"},"Command reference"]],["LI",{},["A",{"href":"/manual/dev/arm-sequence/"},"The arm sequence — from $CLEAR to a live gun"]],["LI",{},["A",{"href":"/manual/dev/weap/"},"$WEAP — the weapon definition"]],["LI",{},["A",{"href":"/manual/dev/gset-pset/"},"$GSET and $PSET — game and player settings"]],["LI",{},["A",{"href":"/manual/dev/sir/"},"$SIR — the incoming-IR effects matrix"]],["LI",{},["A",{"href":"/manual/dev/events/"},"Events — what the gun tells you"]],["LI",{},["A",{"href":"/manual/dev/ir/"},"The IR word — what a shot carries through the air"]],["LI",{},["A",{"href":"/manual/dev/serial-console/"},"The USB serial console — QUERY and SETUP"]],["LI",{},["A",{"href":"/manual/dev/headset-link/"},"Headset, link and what survives"]],["LI",{},["A",{"href":"/manual/dev/brx-mcp/"},"Getting started with brx-mcp"]],["LI",{},["A",{"href":"/manual/dev/captures/","aria-current":"page"},"Captures — recording and decoding the official app"]]]]],"\n  ",["MAIN",{"id":"main","class":"main"},"\n    ",["NAV",{"class":"crumbs","aria-label":"Breadcrumb"},["A",{"href":"/"},"Home"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/"},"Manual"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/dev/"},"Developer reference"],["SPAN",{"class":"sep"},"/"],["SPAN",{"aria-current":"page"},"Captures — recording and decoding the official app"]],"\n    ",["ARTICLE",{"class":"page"},"\n",["HEADER",{"class":"page-head"},"\n",["H1",{},"Captures — recording and decoding the official app"],"\n",["P",{"class":"subtitle"},"How every fact on these pages was obtained, and how to take the next one"],"\n",["P",{"class":"meta"},["SPAN",{"class":"lv"},"Last verified ",["TIME",{"datetime":"2026-08-27"},"2026-08-27"]],["A",{"class":"md-link","href":"/manual/dev/captures.md"},"View as Markdown"]],"\n",["DETAILS",{"class":"legend"},["SUMMARY",{},"What the badges mean"],["UL",{},["LI",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," Verified on our bench"],["LI",{},["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]," Official Battle Company docs"],["LI",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," Decoded from the Callsign app"],["LI",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]," Community-reported"],["LI",{},["SPAN",{"class":"badge b-software","title":"Built + software-tested"},["I",{"aria-hidden":"true"},"🧪"],["SPAN",{},"software"]]," Built + software-tested"],["LI",{},["SPAN",{"class":"badge b-spec","title":"Specified only"},["I",{"aria-hidden":"true"},"📐"],["SPAN",{},"spec"]]," Specified only"],["LI",{},["SPAN",{"class":"badge b-wip","title":"Under construction"},["I",{"aria-hidden":"true"},"🚧"],["SPAN",{},"under construction"]]," Under construction"]],["P",{},"Nothing unconfirmed is published — see ",["A",{"href":"/credits/"},"Credits & sourcing"],"."]],"\n"],"\n",["SECTION",{"class":"blk blk-callout co-info","data-type":"callout"},["ASIDE",{"class":"callout info","role":"note","id":"method"},["STRONG",{"class":"co-title"},"Method."],["P",{},"Almost everything here came from three instruments: BLE HCI captures of the official Callsign app (Android HCI snoop; iOS via macOS PacketLogger), a VS1838B/ESP32 IR receiver+emitter, and a live tagger driven one token at a time. Captures are decoded with ",["CODE",{},"python -m brx_mcp.btsnoop <file>"]," into ",["CODE",{},">>"]," (host→tagger) / ",["CODE",{},"<<"]," (tagger→host) transcripts."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/captures/README.md","rel":"noopener"},"protocol/captures/README.md"],"; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/capture-runbook.md","rel":"noopener"},"docs/capture-runbook.md"]]]],"\n",["SECTION",{"class":"blk blk-steps","data-type":"steps"},["H2",{"id":"ios-the-one-that-works-callsign-is-effectively-ios-only"},"iOS (the one that works — Callsign is effectively iOS-only)"],["DIV",{"class":"steps"},["OL",{},"\n",["LI",{},"Plug the iPhone into a Mac. Open ",["STRONG",{},"PacketLogger"]," (Xcode additional tools) → ",["STRONG",{},"File → New iOS Trace"],". ",["STRONG",{},"Confirm lines are scrolling before you do anything."]],"\n",["LI",{},"Make sure the tagger's ",["STRONG",{},"headset is on and paired"]," — the app silently drops a headset-less gun and you capture nothing. Get the app's connection icon green first."],"\n",["LI",{},"Drive the app: connect, create/join, arm, play, end. For a differential capture change ",["STRONG",{},"exactly one"]," setting per trace."],"\n",["LI",{},["STRONG",{},"File → Export → btsnoop"],". Two traps: export acts on the ",["EM",{},"frontmost"]," window (easy to re-export an old trace), and a trace that wasn't recording writes a silently useless file."],"\n",["LI",{},["CODE",{},"python -m brx_mcp.btsnoop <file>"]," → transcript. ",["CODE",{},"python -m brx_mcp.gsetdiff <capA> <capB> [capC]"]," diffs the config frames across raw captures."],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/capture-runbook.md","rel":"noopener"},"docs/capture-runbook.md"]," (Job 2); ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7m; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/captures/README.md","rel":"noopener"},"protocol/captures/README.md"]]],"\n",["SECTION",{"class":"blk blk-steps","data-type":"steps"},["H2",{"id":"android-partial-the-app-rarely-holds-a-connection-here"},"Android (partial — the app rarely holds a connection here)"],["DIV",{"class":"steps"},["OL",{},"\n",["LI",{},"Enable ",["STRONG",{},"Developer options → Bluetooth HCI snoop log"],"."],"\n",["LI",{},"Run the app; then ",["CODE",{},"adb bugreport"]," (5–10 min; keep the phone still) — the btsnoop log rides inside."],"\n",["LI",{},"Decode with ",["CODE",{},"python -m brx_mcp.btsnoop"],". This route yielded the connect ritual and the version exchange, never a game."],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (#5 HCI snoop)"]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-bash"},"python -m brx_mcp.btsnoop capture.btsnoop            # → '>> $CLEAR,*' / '<< $LCD,…' transcript with timestamps\npython -m brx_mcp.gsetdiff cap5.btsnoop cap6.btsnoop # byte-diff the $GSET/$PSET frames across captures\npython -m brx_mcp.weapmap cap14.btsnoop cap15.btsnoop # token × weapon table from operator-annotated captures\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/captures/README.md","rel":"noopener"},"protocol/captures/README.md"],"; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/callsign-extract/protocol-classes.md","rel":"noopener"},"protocol/callsign-extract/protocol-classes.md"]]],"\n",["SECTION",{"class":"blk blk-callout co-warn","data-type":"callout"},["ASIDE",{"class":"callout warn","role":"note","id":"decoder-gotchas-we-hit"},["STRONG",{"class":"co-title"},"Decoder gotchas we hit."],["P",{},"Apple's btsnoop export uses datalink 1001 (no HCI type byte — the type is in the record flags), which decoded to zero frames until handled. With two guns in one trace, streams must be keyed on the ",["STRONG",{},"ACL connection handle"]," or they merge into garbage silently."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (#4 PacketLogger; cap8 notes)"]]],"\n",["SECTION",{"class":"blk blk-table","data-type":"table"},["H2",{"id":"published-transcripts"},"Published transcripts"],["P",{"class":"lead"},"(decoded frames only — raw btsnoop files contain all of a phone's Bluetooth traffic and are not published)"],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"File"],"\n",["TH",{},"Shows"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},["CODE",{},"2026-08-23-ios-callsign-game-start.txt"]],"\n",["TD",{},"The full working arm sequence (§7e)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"2026-08-23-ios-callsign-two-tagger-combat.txt"]],"\n",["TD",{},["CODE",{},"$HIR"],"/",["CODE",{},"$HP"]," damage, death, host-driven respawn (§7f)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"2026-08-23-gset-respawn15.txt"]," / ",["CODE",{},"-respawn30.txt"]," / ",["CODE",{},"-respawn05.txt"]],"\n",["TD",{},"Byte-identical ",["CODE",{},"$GSET"]," at three respawn values; ",["CODE",{},"respawn15"]," also contains a complete game ending (§7n)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"2026-08-23-no-headset-disconnects.txt"]],"\n",["TD",{},"App ritual completes, zero frames back, hangs up ~1.2 s later (§7m)"],"\n"],"\n"]]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/captures/README.md","rel":"noopener"},"protocol/captures/README.md"]]],"\n",["SECTION",{"class":"blk blk-steps","data-type":"steps"},["H2",{"id":"ir-capture-rig-esp32-s3-vs1838b"},"IR capture rig (ESP32-S3 + VS1838B)"],["DIV",{"class":"steps"},["OL",{},"\n",["LI",{},"A phone camera ",["STRONG",{},"cannot"]," see the ~5 mA IR LED — judge with the receiver, never a camera."],"\n",["LI",{},"Turn the sketch's per-frame RAW dump ",["STRONG",{},"off"]," (",["CODE",{},"r"],") for any capture that matters; it takes ~15–20 ms at 115200 and truncates the next frame into a prefix."],"\n",["LI",{},"Attenuate at close range — the VS1838B's AGC saturates point-blank; a gun at 1 m decodes cleanly where an LED at 5 cm does not."],"\n",["LI",{},"Never fire toward the rig from the gun under test: reflected IR hits your own headset, drains armor and kills the player mid-window."],"\n",["LI",{},"Bound the sync to ~1800–2200 µs and require 25 bits + ",["CODE",{},"Z0 ≠ Z1"],", or a TV remote will decode as a BRX frame."],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/gotchas.md","rel":"noopener"},"docs/gotchas.md"]," (Capturing IR); ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-ir-protocol.md","rel":"noopener"},"protocol/brx-ir-protocol.md"]]],"\n",["SECTION",{"class":"blk blk-callout co-tip","data-type":"callout"},["ASIDE",{"class":"callout tip","role":"note","id":"measurement-discipline-that-mattered"},["STRONG",{"class":"co-title"},"Measurement discipline that mattered."],["P",{},"Check the control ",["EM",{},"before"]," reading the result; one clean-looking run is not a result (everything that held was measured 3× with alternating conditions, or came from a human's senses); a host-visible field that correlates with a state is not evidence of that state; damage is a property of the (weapon, victim ",["CODE",{},"$SIR"]," table) pair, never of the weapon alone."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/gotchas.md","rel":"noopener"},"docs/gotchas.md"]," (Interpreting)"]]],"\n\n"],"\n  "],"\n  ",["ASIDE",{"class":"toc","aria-label":"On this page"},["DIV",{"class":"toc-in"},["P",{"class":"toc-h"},"On this page"],["OL",{},["LI",{},["A",{"href":"#method"},"Method."]],["LI",{},["A",{"href":"#ios-the-one-that-works-callsign-is-effectively-ios-only"},"iOS (the one that works — Callsign is effectively iOS-only)"]],["LI",{},["A",{"href":"#android-partial-the-app-rarely-holds-a-connection-here"},"Android (partial — the app rarely holds a connection here)"]],["LI",{},["A",{"href":"#decoder-gotchas-we-hit"},"Decoder gotchas we hit."]],["LI",{},["A",{"href":"#published-transcripts"},"Published transcripts"]],["LI",{},["A",{"href":"#ir-capture-rig-esp32-s3-vs1838b"},"IR capture rig (ESP32-S3 + VS1838B)"]],["LI",{},["A",{"href":"#measurement-discipline-that-mattered"},"Measurement discipline that mattered."]]]]],"\n"],"\n",["FOOTER",{"class":"foot"},"\n  ",["P",{},"Protocol discovered by ",["A",{"href":"https://github.com/LaserTagMods","rel":"noopener"},"LaserTagMods"]," (JEDGE / JBOX) · Hardware by Battle Company · Fixes by the owner community."],"\n  ",["P",{},"Open BRX is an independent open-source project and is not affiliated with or endorsed by Battle Company. MIT licence. ",[