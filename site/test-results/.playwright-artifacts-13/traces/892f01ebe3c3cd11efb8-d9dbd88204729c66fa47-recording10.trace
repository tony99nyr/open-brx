"noopener"},"protocol/brx-ir-protocol.md"],"; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-26 melee capture)"]],"\n",["SECTION",{"class":"blk blk-diagram","data-type":"diagram"},["FIGURE",{"class":"fig fig-svg fig-pending","id":"DEV-06","style":"--ratio:16/9"},["DIV",{"class":"ph ph-svg","role":"img","aria-label":"25-bit field ruler: B(4) P(6) T(2) D(8) C(1) U(2) Z(2) with bit offsets 0–24 below, plus a pulse-train strip above showing the 2 ms sync, then long (≈1000 µs) and short (≈500 µs) marks for the sample word `1101000111010101101000110`, and the trailing short end pulse. Under each field: \"= $WEAP t3 / $HIR tok2\", \"= $PSET t1 / $HIR tok3\", \"= $TID & 3 / $HIR tok4\", \"= $WEAP t5 / $HIR tok5\", \"= $HIR tok6 (×1.5)\", \"= $SIR subtype / $HIR tok7\", \"parity: odd→01 even→10; gun checks only Z0≠Z1\"."},["SPAN",{"class":"ph-id"},"DEV-06"],["SPAN",{"class":"ph-kind"},"diagram pending"]],["FIGCAPTION",{},"Bit-field ruler of the 25-bit word with the sync pulse and a sample pulse train (",["CODE",{},"1101000111010101101000110"]," = protocol 13, player 7, team 1, magnitude 90, crit 0, subtype 1 — a genuine captured melee swing)."]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-26 melee)"]],"\n",["SECTION",{"class":"blk blk-callout co-tip","data-type":"callout"},["ASIDE",{"class":"callout tip","role":"note","id":"parity-what-genuine-frames-emit-vs-what-the-gun-checks"},["STRONG",{"class":"co-title"},"Parity — what genuine frames emit vs what the gun checks."],["P",{},"Real BRX frames set Z by parity over bits 0–22: ",["STRONG",{},"odd number of ones → ",["CODE",{},"01"],", even → ",["CODE",{},"10"]]," (4/4 captured frames). But the gun's acceptance test is only ",["STRONG",{},["CODE",{},"Z0 ≠ Z1"]],": ",["CODE",{},"01"]," and ",["CODE",{},"10"]," both land 8/8, ",["CODE",{},"00"]," and ",["CODE",{},"11"]," are rejected 0/8. Compute the true parity for fidelity; use the mismatch to tell your own traffic from a real gun's."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-ir-protocol.md","rel":"noopener"},"protocol/brx-ir-protocol.md"]]]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-python"},"def encode_word(proto: int, player: int, team: int, magnitude: int, crit: int, subtype: int) -> str:\n    \"\"\"25-bit BRX IR word as a bit string (MSB of each field first), Z = genuine-frame parity.\"\"\"\n    bits = (f\"{proto & 0xF:04b}{player & 0x3F:06b}{team & 0x3:02b}\"\n            f\"{magnitude & 0xFF:08b}{crit & 1:01b}{subtype & 0x3:02b}\")\n    ones = bits.count(\"1\")\n    return bits + (\"01\" if ones % 2 else \"10\")\n\ndef decode_word(bits: str) -> dict:\n    assert len(bits) == 25\n    payload, z = bits[:23], bits[23:]\n    return {\n        \"proto\": int(payload[0:4], 2), \"player\": int(payload[4:10], 2),\n        \"team\": int(payload[10:12], 2), \"magnitude\": int(payload[12:20], 2),\n        \"crit\": int(payload[20]), \"subtype\": int(payload[21:23], 2),\n        \"accepted\": z[0] != z[1],\n        \"parity_matches\": z == (\"01\" if payload.count(\"1\") % 2 else \"10\"),\n    }\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-ir-protocol.md","rel":"noopener"},"protocol/brx-ir-protocol.md"]," (rule); illustrative implementation"]],"\n",["SECTION",{"class":"blk blk-table","data-type":"table"},["H2",{"id":"native-emissions-captured-off-the-air"},"Native emissions captured off the air"],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"Source"],"\n",["TH",{},"Word"],"\n",["TH",{},"Note"],"\n",["TH",{},"Conf"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},"Assault Rifle"],"\n",["TD",{},"proto 0, magnitude 9"],"\n",["TD",{},"The stock AR emits 9, not the manual's 24"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"Shotgun"],"\n",["TD",{},"proto 0, magnitude 45"],"\n",["TD"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"Sniper"],"\n",["TD",{},"proto 0, subtype 1, magnitude 80"],"\n",["TD"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"Rocket Launcher"],"\n",["TD",{},"proto 10, magnitude 115"],"\n",["TD"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"Melee (gyro swing, native game)"],"\n",["TD",{},"proto 13, subtype 1, magnitude 90"],"\n",["TD",{},"Subtype 1 = Rifle Bash"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"Supremacy Sentinel death-nova (headset)"],"\n",["TD",{},"proto 10, magnitude 125, player/team = the ",["STRONG",{},"dying"]," player"],"\n",["TD",{},"Out-damages the rocket; credits kills to the corpse"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n"]]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7r addendum; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]]],"\n",["SECTION",{"class":"blk blk-callout co-warn","data-type":"callout"},["ASIDE",{"class":"callout warn","role":"note","id":"headset-emission-cannot-be-forced-over-ble"},["STRONG",{"class":"co-title"},"Headset emission cannot be forced over BLE."],["P",{},["CODE",{},"$IRTX"],", ",["CODE",{},"$HFIRE"],", ",["CODE",{},"$MELEE"]," and ",["CODE",{},"$BHIT"]," produced zero IR with a receiver control passing before and after. The headset emits only for a physical melee swing in a native game and for the Sentinel death-nova."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-26 headset emission)"]]],"\n",["SECTION",{"class":"blk blk-faq","data-type":"faq"},["DIV",{"class":"faq"},["DETAILS",{},["SUMMARY",{},"Do I need a victim gun to test an emitter?"],["DIV",{},["P",{},"No — a VS1838B on an ESP32 decodes the word, and the sync/mark timings above are the acceptance spec."],"\n"]],["DETAILS",{},["SUMMARY",{},"Can a station revive a dead player by IR?"],["DIV",{},["P",{},"No. A dead gun ignores all IR; stations ",["EM",{},"arm"]," a living tagger's respawn path."],"\n"]],["DETAILS",{},["SUMMARY",{},"Why do my captured frames come out as prefixes (16/17/20/21 bits)?"],["DIV",{},["P",{},"Your capture sketch is printing while the next frame lands. Turn the RAW dump off."],"\n"]]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-ir-protocol.md","rel":"noopener"},"protocol/brx-ir-protocol.md"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (448-word brute force) · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/gotchas.md","rel":"noopener"},"docs/gotchas.md"],"; ",["A",{"href":"ht