,"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$LCD,<hp>,<armor>,<t3>,<t4>,<mag>,<reserve>,*"]],"\n",["TD",{},"e.g. ",["CODE",{},"45,70,0,0,36,216"]],"\n",["TD",{},["STRONG",{},"Health/armor HUD echo."]," ",["CODE",{},"$START"]," → all zeros; ",["CODE",{},"$SPAWN"]," → pools + current weapon's ammo; death → ",["CODE",{},"$LCD,0,0,0,1,1,1,*"],". Tokens 3–4: — (unknown). A zeroed ",["CODE",{},"$LCD"]," after ",["CODE",{},"$SPAWN"]," means \"no config loaded\" (post power-cycle tell)."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$ALCD,<mag>,<t2>,<slot>,<reserve>,<heat>,*"]],"\n",["TD",{},"e.g. ",["CODE",{},"36,100,0,108,0"]],"\n",["TD",{},["STRONG",{},"Ammo/weapon HUD stream."]," Per-round during fire ",["EM",{},"and"]," reload (mag 0→1→2… as reserve drains). Token 2: — (unknown) — reads 100 in normal play and drops to 0 after a ",["CODE",{},"$SIR"]," fn 23 hit. Token 3 = weapon slot. Token 5 = ",["STRONG",{},"weapon heat"]," (0–100+, only on overheat weapons). Only streams on ammo events — silence is not \"no change\"."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$HIR,<sensor>,<irProto>,<shooterId>,<shooterTeam>,<magnitude>,<crit>,<subtype>,*"]],"\n",["TD",{},"e.g. ",["CODE",{},"4,0,19,2,9,0,3"]],"\n",["TD",{},["STRONG",{},"Hit received."]," → Events page for the full decode."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$HP,<hp>,<armor>,<shield>,*"]],"\n",["TD",{},"e.g. ",["CODE",{},"43,0,0"]],"\n",["TD",{},"Pools after a hit; arrives in the same millisecond as its ",["CODE",{},"$HIR"],". ",["CODE",{},"$HP,0,0,0"]," = death."],"\n",["TD",{},["SPAN",{"