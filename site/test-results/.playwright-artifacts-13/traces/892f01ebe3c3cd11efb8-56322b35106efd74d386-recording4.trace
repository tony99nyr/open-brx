nch","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$CONNECT,*"]," / ",["CODE",{},"$INIT,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"—"],"\n",["TD",{},"On the known-safe list. Sent on v4.32: ",["STRONG",{},"no observable reply"],"."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$CLEAR,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"—"],"\n",["TD",{},"Clear current game state. First frame of every arm sequence; half of the panic sequence."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$START,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"—"],"\n",["TD",{},"Begin the configuration sequence. Gun echoes ",["CODE",{},"$LCD,0,0,0,0,0,0,*"],"."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$GSET,…,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"8 tokens"],"\n",["TD",{},"Global game settings — friendly fire, indoor/outdoor, region, ambient light, gyro, BT secondaries, crit modifier, mods. ",["STRONG",{},"No respawn/time/lives token."]," → GSET page"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$PSET,…,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"id, 0, HP, armor, shield, 50, , voice-pack…"],"\n",["TD",{},"Player settings: ",["STRONG",{},"token 1 = player id (0–63)"],", tokens 3–5 = HP/armor/shield pools, then a positional voice pack. → PSET page"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$WEAP,<slot>,…,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"slot 0–5 + ~43 tokens"],"\n",["TD",{},"Define a weapon in a slot: damage, fire interval, fire mode, clip/reserve, reload, sounds, IR type. → WEAP page"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$SIR,<proto>,<subtype>,<sound>,<fn>,p5,p6,p7,p8,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"8 tokens"],"\n",["TD",{},"Incoming-IR effects matrix: what an IR word with protocol B / subtype U does to this gun. ",["STRONG",{},"Unmatched cells are silently ignored."]," → SIR page"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$BMAP,<button>,<function>,<swap0..3>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"button id, function, 4 swap slots"],"\n",["TD",{},"Remap physical controls. Buttons: 0 trigger · 1 alt-fire · 2 reload handle · 3 select · 4 left · 5 right · 8 gyro. Functions seen: 0 fire · 97 reload · 98 (select/left/right) · 100 weapon-cycle · 4 melee (gyro). ",["STRONG",{},"Mandatory"]," — without it the trigger only chirps \"disabled\"."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$TID,<team>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"team"],"\n",["TD",{},"Team id. ",["STRONG",{},"Masked to 2 bits"]," (",["CODE",{},"team & 3"],") → four native teams 0–3. Drives the gun LED colour at ",["CODE",{},"$SPAWN"]," (1 = blue, 2 = yellow observed) and is echoed as ",["CODE",{},"$HIR"]," token 4 on the victim. A live write changes hit resolution immediately but does not repaint LEDs."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$SPAWN,,*"]],"\n",["TD",{},">>"],"\n",["TD",{},["STRONG",{},"one empty token"]],"\n",["TD",{},["STRONG",{},"Go-live"]," and ",["STRONG",{},"respawn"],". Restores HP/armor and (on respawn) ammo; echoes ",["CODE",{},"$LCD,<hp>,<armor>,0,0,<mag>,<reserve>,*"],". Also clears the ",["CODE",{},"$SIR"]," fn-23 state (",["CODE",{},"$ALCD"]," token 2 back to 100). ",["CODE",{},"$SPAWN,*"]," (no empty token) is not the same command."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$AMMO,<slot>,<mag>,<reserve>,<flag>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"slot, magazine, reserve, 1"],"\n",["TD",{},"Load magazines. Must follow ",["CODE",{},"$SPAWN"]," at initial go-live or the gun is live with no ammunition. e.g. ",["CODE",{},"$AMMO,0,36,108,1,*"],". A bare ",["CODE",{},"$WEAP"]," re-push resets ammo to the frame's baked values — re-send ",["CODE",{},"$AMMO"]," after any weapon swap."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$PLAYX,0,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"0"],"\n",["TD",{},"Stop/clear sound playback. Sent right after ",["CODE",{},"$STOP"]," on connect and just before the go-live cue."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$PLAY,<sound>,<vol>,<prio>,<announcer>,,,,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"8 tokens"],"\n",["TD",{},"Play a sound id (see the 2166-id bank). ",["STRONG",{},"Two independent slots"],": token 1 = local/effect sound, ",["STRONG",{},"token 4 = announcer/voice channel"]," — ",["CODE",{},"$PLAY,,4,6,V3A,,,,*"]," speaks \"kill\" with token 1 empty; ",["CODE",{},"$PLAY,VSF,4,6,JAY,,,,*"]," uses both. ",["STRONG",{},"Tokens 2–3 are required"],": ",["CODE",{},"$PLAY,VA33,,,,,,,*"]," is silent, ",["CODE",{},"$PLAY,VA33,4,6,,,,,*"]," speaks. Numeric values vary by client (",["CODE",{},"3,9"]," Android app · ",["CODE",{},"3,6"]," iOS · ",["CODE",{},"4,6"]," JEDGE). APK field names: soundName, addToQue1, addToQue2, loopingTime, stun, isNeedQueue."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$VOL,<0–100>,<n2>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"volume, 0"],"\n",["TD",{},"Master volume. Android app sends ",["CODE",{},"$VOL,100,0,*"],"; iOS ",["CODE",{},"$VOL,69,0,*"],". 30 is inaudible for game audio; use 69."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$NAME,<name>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"name"],"\n",["TD",{},"Sets the gun's ",["STRONG",{},"persistent"]," name (the USB ",["CODE",{},"Gun Name"]," field; survives power-cycle). Opening the official app rewrites it to ",["CODE",{},"Tactix2"],"."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$VERSION,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"—"],"\n",["TD",{},"Query firmware. Reply ",["CODE",{},"$VERSION,v4.32,?,4,,devhost.03,*"]," — token 2 is the ",["STRONG",{},"headset"]," firmware (",["CODE",{},"hds.59"],") when a headset is linked."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$SP,<n>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"n"],"\n",["TD",{},"End-of-game / stop. ",["CODE",{},"$SP,99,*"]," is the second half of the panic sequence. Do not probe it mid-game hoping for a score — the gun keeps none."],"\n",["TD",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$QUERY,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"—"],"\n",["TD",{},"Over BLE returns a ",["CODE",{},"$"],"-framed status array (",["CODE",{},"$QUERY,0,0,0,0,0,,1,0,,0,…"],") plus a ",["CODE",{},"$LCD"],". ",["STRONG",{},"Not"]," the USB device record (that is USB-only — see the Serial console page)."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n"]]],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §3, §7a, §7e, §7f, §7l, §7o, §7r; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/gotchas.md","rel":"noopener"},"docs/gotchas.md"],"; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-24 $QUERY)"]],"\n",["SECTION",{"class":"blk blk-data-table","data-type":"data-table"},["H2",{"id":"host-tagger-in-game-effects-feedback-pools"},"Host → tagger: in-game effects, feedback & pools"],["DIV",{"class":"dt","data-rows":"12"},["DIV",{"class":"dt-bar"},["INPUT",{"__playwright_value_":"","type":"search","placeholder":"Filter this table…","aria-label":"Filter table"}],["SPAN",{"class":"dt-count","aria-live":"polite"},"12 rows"]],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{"data-sort":"1","tabindex":"0","aria-sort":"none"},"Command"],"\n",["TH",{"data-sort":"1","tabindex":"0","aria-sort":"none"},"Dir"],"\n",["TH",{"data-sort":"1","tabindex":"0","aria-sort":"none"},"Args"],"\n",["TH",{"data-sort":"1","tabindex":"0","aria-sort":"none"},"Meaning"],"\n",["TH",{"data-sort":"1","tabindex":"0","aria-sort":"none"},"Conf"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},["CODE",{},"$SFLASH,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"—"],"\n",["TD",{},["STRONG",{},"The shooter's green-sight kill-confirm flash."]," The host sends exactly one per kill the holder scores, ~0.4 s after the trigger burst ends. (The APK lists it under notifications; on the wire the phone sends it.)"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$LIFE,<hp>,<armor>,<shields>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"addedHP, addedArmor, addedShields"],"\n",["TD",{},"Grant health. ",["STRONG",{},"Additive, clamped at the pool max"]," — not an absolute set. Writes do not self-emit ",["CODE",{},"$HP"],"; the new value shows on the next hit/HUD refresh."],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$BUMP,<hp>,<armor>,<shields>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"hP, armor, shields"],"\n",["TD",{},"Adjust current pools. Same additive/clamped behaviour as ",["CODE",{},"$LIFE"],"."],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$BHIT,<damage>,<isCrit>,<powerLevel>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"damage, isCriticalShot, powerLevel"],"\n",["TD",{},"Four shapes sent on v4.32: each was echoed and ",["STRONG",{},"applied no damage"],"."],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," (fields) ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," (bench result)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$HFIRE,…,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"Range, CountIRPulses, RateOfFire, FlashLED"],"\n",["TD",{},"Five shapes sent on v4.32: ",["STRONG",{},"zero IR emitted"]," (receiver control passing before and after)."],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," (fields) ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," (bench result)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$IRTX,…,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"iRPower, soundOnHit, rangeOutdoor, rangeIndoor"],"\n",["TD",{},"Five shapes sent on v4.32: ",["STRONG",{},"zero IR emitted"]," (receiver control passing before and after)."],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," (fields) ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," (bench result)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$MELEE,<intensity>,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"intensity"],"\n",["TD",{},["CODE",{},"$MELEE,255,*"]," returns ",["CODE",{},"$BUT,4,0,*"]," and fires no IR."],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]],"(no-op)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$STUN,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"—"],"\n",["TD",{},"Listed in the APK. ",["STRONG",{},"Proven no-op over BLE."]],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]],"(no-op)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$GLED,<mid>,<effect>,<optionA>,<optionB>,…,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"mid, effect, optionA, optionB"],"\n",["TD",{},"Gun LED ",["STRONG",{},"effect"]," — ",["CODE",{},"effect"]," = LedEffect enum (Solid, Glow, ChaseBack, ChaseForward, StopIR). ",["STRONG",{},"Not RGB"],": colour is team-derived from ",["CODE",{},"$TID"],". Used by the app during the pre-game lobby."],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]],"(not RGB)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$GREN,…,*"]],"\n",["TD",{},">>"],"\n",["TD",{},"iRType, crit, modifier, indoorMode, operationMode, channel, GrenadeType, MaxCount"],"\n",["TD",{},"Smart Grenade configuration frame, addressed to the ",["STRONG",{},"gun"],". GrenadeMode enum: FlashBang / Gas / Confusion / Molotov. Sent on the bench: the gun emitted IR, but the emitted bits did not track the arguments."],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," (fields) ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," (bench result)"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$PBGAME,$PBTEAM,$PBWEAP,$PBPERK,$PBLIVES,$PBTIME,$PBSPAWN,$PBINDOOR,$PBLOCK,$PBSTART"]],"\n",["TD",{},">>"],"\n",["TD",{},"enum index"],"\n",["TD",{},"The ",["STRONG",{},"\"playbook\""]," pre-battle family mirroring the on-gun menu — a second remote-start path 