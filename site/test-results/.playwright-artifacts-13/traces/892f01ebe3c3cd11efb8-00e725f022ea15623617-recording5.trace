{"type":"frame-snapshot","snapshot":{"callId":"call@223","snapshotName":"before@call@223","pageId":"page@61dc337884b6ac580c49ae602f6b7a35","frameId":"frame@44eb5531186ccebed900e5bdf733e1c6","frameUrl":"http://localhost:4173/manual/dev/arm-sequence/","doctype":"html","html":["HTML",{"lang":"en","data-theme":""},[[7,24]],[[7,25]],["BODY",{"class":""},[[7,26]],[[7,28]],[[7,29]],[[7,65]],[[7,66]],["DIV",{"class":"layout has-side has-toc"},[[7,67]],[[7,284]],[[7,285]],["MAIN",{"id":"main","class":"main"},[[7,286]],[[7,301]],[[7,302]],["ARTICLE",{"class":"page"},[[7,303]],["HEADER",{"class":"page-head"},[[7,304]],[[2,0]],[[7,310]],[[7,312]],[[7,313]],["P",{"class":"meta"},[[7,318]],["SPAN",{"class":"lv"},[[7,319]],["TIME",{"datetime":"2026-08-27"},[[7,320]]]],[[7,324]]],[[7,326]],[[7,384]],[[7,385]]],[[7,387]],[[7,418]],[[7,419]],[[7,433]],[[7,434]],[[7,468]],[[7,469]],[[7,570]],[[7,571]],[[7,602]],[[7,603]],[[7,673]],[[7,674]],[[7,699]],[[7,700]],[[7,714]],[[7,715]],[[7,772]],[[7,773]]],[[7,775]]],[[7,777]],[[7,794]],[[7,795]]],[[7,797]],[[7,819]],[[7,820]],[[7,828]],[[7,829]],[[7,830]]]],"viewport":{"width":390,"height":844},"timestamp":49296.304,"wallTime":1787863201757,"collectionTime":0.7999999523162842,"resourceOverrides":[],"isMainFrame":true}}
