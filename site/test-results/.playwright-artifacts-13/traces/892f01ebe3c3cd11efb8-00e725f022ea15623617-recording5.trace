A",{"href":"/manual/dev/brx-mcp/"},"Getting started with brx-mcp"]],["LI",{},["A",{"href":"/manual/dev/captures/"},"Captures — recording and decoding the official app"]]]]],"\n  ",["MAIN",{"id":"main","class":"main"},"\n    ",["NAV",{"class":"crumbs","aria-label":"Breadcrumb"},["A",{"href":"/"},"Home"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/"},"Manual"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/dev/"},"Developer reference"],["SPAN",{"class":"sep"},"/"],["SPAN",{"aria-current":"page"},"The arm sequence — from $CLEAR to a live gun"]],"\n    ",["ARTICLE",{"class":"page"},"\n",["HEADER",{"class":"page-head"},"\n",["H1",{},"The arm sequence — from ",["CODE",{},"$CLEAR"]," to a live gun"],"\n",["P",{"class":"subtitle"},"The exact frame order that takes a tagger live, respawns it, and ends the game — captured from the official app and reproduced by our host"],"\n",["P",{"class":"meta"},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]],["SPAN",{"class":"lv"},"Last verified ",["TIME",{"datetime":"2026-08-27"},"2026-08-27"]],["A",{"class":"md-link","href":"/manual/dev/arm-sequence.md"},"View as Markdown"]],"\n",["DETAILS",{"class":"legend"},["SUMMARY",{},"What the badges mean"],["UL",{},["LI",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," Verified on our bench"],["LI",{},["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]," Official Battle Company docs"],["LI",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," Decoded from the Callsign app"],["LI",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]," Community-reported"],["LI",{},["SPAN",{"class":"badge b-software","title":"Built + software-tested"},["I",{"aria-hidden":"true"},"🧪"],["SPAN",{},"software"]]," Built + software-tested"],["LI",{},["SPAN",{"class":"badge b-spec","title":"Specified only"},["I",{"aria-hidden":"true"},"📐"],["SPAN",{},"spec"]]," Specified only"],["LI",{},["SPAN",{"class":"badge b-wip","title":"Under construction"},["I",{"aria-hidden":"true"},"🚧"],["SPAN",{},"under construction"]]," Under construction"]],["P",{},"Nothing unconfirmed is published — see ",["A",{"href":"/credits/"},"Credits & sourcing"],"."]],"\n"],"\n",["SECTION",{"class":"blk blk-callout co-info","data-type":"callout"},["ASIDE",{"class":"callout info","role":"note"},["P",{},"This sequence was captured from the official iOS app driving a live game on firmware v4.32, then reproduced byte-for-byte by our own host on real taggers. Three pieces were missing from every earlier attempt: ",["STRONG",{},["CODE",{},"$AMMO"]," after spawn"],", ",["STRONG",{},["CODE",{},"$BMAP"]," before ",["EM",{},"and"]," after spawn"],", and the ",["STRONG",{},"empty token in ",["CODE",{},"$SPAWN,,*"]],"."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7e, §7o; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/captures/2026-08-23-ios-callsign-game-start.txt","rel":"noopener"},"protocol/captures/2026-08-23-ios-callsign-game-start.txt"]]]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-text"},"$CLEAR,*\n$START,*\n$GSET,1,0,1,0,1,0,50,1,*\n$PSET,0,0,45,70,70,50,,H44,JAD,V33,V3I,V3C,V3G,V3E,V37,H06,H55,H13,H21,H02,U15,W71,A10,*\n$WEAP,0,...                (primary)\n$WEAP,1,...                (secondary)\n$WEAP,4,...                (melee — always sent)\n$SIR,... x10               (incoming-IR effects table)\n$BMAP,0,0,,,,,*   $BMAP,1,100,0,1,99,99,*   $BMAP,2,97,,,,,*\n$BMAP,3,98,,,,,*  $BMAP,4,98,,,,,*          $BMAP,5,98,,,,,*\n$BMAP,8,4,,,,,*\n$TID,<team>,*              (ours; the app relies on defaults)\n$PLAYX,0,*\n$PLAY,VA81,4,6,,,,,*       (go-live voice cue)\n$SPAWN,,*                  <-- go-live (note the empty token)\n$AMMO,0,36,108,1,*         <-- load magazines\n$AMMO,1,6,12,1,*\n$BMAP,0,0,,,,,*            <-- trigger re-mapped AFTER spawn\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7e, §7k"]],"\n",["SECTION",{"class":"blk blk-diagram","data-type":"diagram"},["FIGURE",{"class":"fig fig-svg fig-pending","id":"DEV-04","style":"--ratio:16/9"},["DIV",{"class":"ph ph-svg","role":"img","aria-label":"Sequence diagram, two lifelines HOST and TAGGER. Downward arrows in order: `$CLEAR` `$START` (return `$LCD,0,0,0,0,0,0`) `$GSET` `$PSET` `$WEAP×3` `$SIR×10` `$BMAP×7` `$TID` `$PLAYX,0` `$PLAY,VA81,4,6` `$SPAWN,,` (return `$LCD,45,70,0,0,36,216`) `$AMMO,0,36,108,1` `$AMMO,1,6,12,1` `$BMAP,0,0`. Then a shaded \"in play\" band with `$BUT,0,1`/`$ALCD` returns. Then a death band: return `$HP,0,0,0` + `$LCD,0,0,0,1,1,1`; host `$HLOOP,0,0` (~1.7 s); host `$SPAWN,,` (~10 s) return `$LCD,45,70,0,0,36,216`. Then end: `$VOL,69,0` `$HLED,,6` `$STOP` `$CLEAR` `$PLAY,VSF,4,6,JAY`. Blue for host frames, amber for gun echoes."},["SPAN",{"class":"ph-id"},"DEV-04"],["SPAN",{"class":"ph-kind"},"diagram pending"]],["FIGCAPTION",{},"Sequence diagram: host → gun frames above, with the gun's echoes (",["CODE",{},"$LCD,0,0,0,0,0,0"]," after ",["CODE",{},"$START"],"; ",["CODE",{},"$LCD,45,70,0,0,36,216"]," after ",["CODE",{},"$SPAWN"],"; ",["CODE",{},"$ALCD"]," per shot; ",["CODE",{},"$BUT"]," per trigger)."]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7e"]],"\n",["SECTION",{"class":"blk blk-table","data-type":"table"},["H2",{"id":"what-the-gun-echoes-back"},"What the gun echoes back"],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"After"],"\n",["TH",{},"Echo"],"\n",["TH",{},"Meaning"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},["CODE",{},"$START,*"]],"\n",["TD",{},["CODE",{},"$LCD,0,0,0,0,0,0,*"]],"\n",["TD",{},"Cleared state"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"$SPAWN,,*"]],"\n",["TD",{},["CODE",{},"$LCD,45,70,0,0,36,216,*"]],"\n",["TD",{},"Live: HP 45, armor 70, mag 36, reserve 216 (this config)"],"\n"],"\n",["TR",{},"\n",["TD",{},"each shot"],"\n",["TD",{},["CODE",{},"$ALCD,35,100,0,108,0,*"]," …"],"\n",["TD",{},"Mag decrementing, slot 0, reserve, heat"],"\n"],"\n",["TR",{},"\n",["TD",{},"each trigger"],"\n",["TD",{},["CODE",{},"$BUT,0,1,*"]," / ",["CODE",{},"$BUT,0,0,*"]],"\n",["TD",{},"Press / release"],"\n"],"\n",["TR",{},"\n",["TD",{},"~30 s"],"\n",["TD",{},["CODE",{},"$VOLTS,7634,3770,53,45,*"]],"\n",["TD",{},"Telemetry continues in-game"],"\n"],"\n"]]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7e"]],"\n",["SECTION",{"class":"blk blk-callout co-warn","data-type":"callout"},["ASIDE",{"class":"callout warn","role":"note","id":"the-config-head-is-silent-and-safe"},["STRONG",{"class":"co-title"},"The config head is silent and safe."],["P",{},"Writing ",["CODE",{},"$CLEAR … $TID"]," without ",["CODE",{},"$SPAWN"]," plays nothing and ",["STRONG",{},"a configured-but-unspawned gun ignores IR"]," — no ",["CODE",{},"$HIR"],", no ",["CODE",{},"$HP"],". \"Get some\" and the cocking sound belong to ",["CODE",{},"$SPAWN"],". A head held unspawned for ~2 minutes then spawned went live with config intact."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7r"]]],"\n",["SECTION",{"class":"blk blk-steps","data-type":"steps"},["H2",{"id":"death-and-respawn-are-host-driven"},"Death and respawn are host-driven"],["DIV",{"class":"steps"},["OL",{},"\n",["LI",{},"Victim reports ",["CODE",{},"$HP,0,0,0,*"]," then ",["CODE",{},"$LCD,0,0,0,1,1,1,*"],". The gun does ",["STRONG",{},"not"]," revive itself, and a dead gun's trigger produces ",["CODE",{},"$BUT"]," events but no ",["CODE",{},"$ALCD"]," decrement (it cannot fire)."],"\n",["LI",{},"The app sends ",["CODE",{},"$HLOOP,0,0,*"]," ~1.7 s after death."],"\n",["LI",{},"After the game's respawn delay (the app's own timer — ~10 s in the capture; ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]," community: a per-death ramp capping at 45/90 s) the host sends ",["CODE",{},"$SPAWN,,*"],"."],"\n",["LI",{},"Gun echoes ",["CODE",{},"$LCD,45,70,0,0,36,216,*"]," — HP, armor ",["STRONG",{},"and ammo"]," restored with no ",["CODE",{},"$AMMO"]," needed."],"\n",["LI",{},["STRONG",{},"A dead gun ignores all incoming IR"]," — 448 distinct words, including every grenade-beacon shape, failed to revive one. Only the host can."],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7f, §7j(community ramp), §7q; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-26 448-word brute force)"]],"\n",["SECTION",{"class":"blk blk-callout co-warn","data-type":"callout"},["ASIDE",{"class":"callout warn","role":"note","id":"after-a-ble-drop-re-send-the-whole-head"},["STRONG",{"class":"co-title"},"After a BLE drop, re-send the whole head."],["P",{},"Re-sending the full sequence (",["CODE",{},"$CLEAR"],"→",["CODE",{},"$START"],"→…→",["CODE",{},"$SPAWN,,*"],"→",["CODE",{},"$AMMO"],") on a fresh link brought a gun back in every bench case."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7r and §7r addendum"]]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-text"},"# Clean end-of-game, as the official app does it (note the ~3.9 s settle before the last $PLAY):\n$VOL,69,0,*\n$HLED,,6,,,,,*\n$STOP,*\n$CLEAR,*\n$PLAY,VSF,4,6,JAY,,,,*     # victory sting (slot 1) + \"victory\" announcer (slot 4); solo game: $PLAY,VS6,4,6,,,,,*\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7e, §7n, §7o"]],"\n",["SECTION",{"class":"blk blk-faq","data-type":"faq"},["DIV",{"class":"faq"},["DETAILS",{},["SUMMARY",{},"Do I need the reload-handle pull?"],["DIV",{},["P",{},"No. The manual's reload-handle pull is the ",["EM",{},"local"]," start; ",["CODE",{},"$SPAWN,,*"]," is the ",["EM",{},"remote"]," one. Both exist."],"\n"]],["DETAILS",{},["SUMMARY",{},"Where do respawn time, game time, lives and score-to-win go?"],["DIV",{},["P",{},"Nowhere on the gun. Three captures at respawn 5/15/30 s gave byte-identical ",["CODE",{},"$GSET"],"/",["CODE",{},"$PSET"],". Your host keeps the clock."],"\n"]],["DETAILS",{},["SUMMARY",{},"Is the second ",["CODE",{},"$BMAP,0,0"]," (after ",["CODE",{},"$SPAWN"],") needed?"],["DIV",{},["P",{},"Yes — omit it and the trigger is dead."],"\n"]]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7e · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7n · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7e, §7r addendum"]],"\n\n"],"\n  "],"\n  ",["ASIDE",{"class":"toc","aria-label":"On this page"},["DIV",{"class":"toc-in"},["P",{"class":"toc-h"},"On this page"],["OL",{},["LI",{},["A",{"href":"#what-the-gun-echoes-back"},"What the gun echoes back"]],["LI",{},["A",{"href":"#the-config-head-is-silent-and-safe"},"The config head is silent and safe."]],["LI",{},["A",{"href":"#death-and-respawn-are-host-driven"},"Death and respawn are host-driven"]],["LI",{},["A",{"href":"#after-a-ble-drop-re-send-the-whole-head"},"After a BLE drop, re-send the whole head."]]]]],"\n"],"\n",["FOOTER",{"class":"foot"},"\n  ",["P",{},"Protocol discovered by ",["A",{"href":"https://github.com/LaserTagMods","rel":"noopener"},"LaserTagMods"]," (JEDGE / JBOX) · Hardware by Battle Company · Fixes by the owner community."],"\n  ",["P",{},"Open BRX is an independent open-source project and is not affiliated with or endorsed by Battle Company. MIT licence. ",["A",{"href":"/credits/"},"Credits & sourcing"]," · ",["A",{"href":"/changelog/"},"Changelog"]," · ",["A",{"href":"/llms.txt"},"llms.txt"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx","rel":"noopener"},"GitHub"]],"\n"],"\n",["DIV",{"class":"search-modal","data-search-modal":"","hidden":""},["DIV",{"class":"search-box","role":"dialog","aria-label":"Search"},["INPUT",{"__playwright_value_":"","type":"search","data-search-input":"","placeholder":"Search pages, headings, weapons, sound ids, commands…","autocomplete":"off"}],["DIV",{"class":"search-results","data-search-results":"","aria-live":"polite"},["P",{"class":"muted"},"Type to search."]],["P",{"class":"search-hint"},"Esc to close"]]],"\n","\n\n"]],"viewport":{"width":390,"height":844},"timestamp":49270.034,"wallTime":1787863201730,"collectio