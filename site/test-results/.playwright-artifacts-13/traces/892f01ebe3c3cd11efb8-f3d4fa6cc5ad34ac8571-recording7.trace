r"},"protocol/brx-protocol.md"]," §3, §7n; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (FF enforcement table)"]],"\n",["SECTION",{"class":"blk blk-callout co-info","data-type":"callout"},["ASIDE",{"class":"callout info","role":"note","id":"there-is-no-respawn-time-lives-or-score-token"},["STRONG",{"class":"co-title"},"There is no respawn, time, lives or score token."],["P",{},"Three captures at respawn 5/15/30 s and different clocks produced byte-identical ",["CODE",{},"$GSET"]," and ",["CODE",{},"$PSET"],", and the 8-field map from the app metadata contains none of them. Those live in the host. Stop looking."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7n"]]],"\n",["SECTION",{"class":"blk blk-table","data-type":"table"},["H2",{"id":"pset-sample-pset-6-0-45-70-70-50-h44-jad-v33-v3i-v3c-v3g-v3e"},["CODE",{},"$PSET,<t1>,…,*"]," — sample ",["CODE",{},"$PSET,6,0,45,70,70,50,,H44,JAD,V33,V3I,V3C,V3G,V3E,V37,H06,H55,H13,H21,H02,U15,W71,A10,*"]],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"tok"],"\n",["TH",{},"Field"],"\n",["TH",{},"Sample"],"\n",["TH",{},"Meaning"],"\n",["TH",{},"Conf"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},"1"],"\n",["TD",{},["STRONG",{},"player id"]],"\n",["TD",{},"6"],"\n",["TD",{},["STRONG",{},"0-based, 0–63 (6 bits)"]," — the app's UI shows 1–64 and writes id−1 (app 7 → wire 6, app 64 → 63, an out-of-range 69 clamps to 63). Ends up in every IR shot's P field and comes back as ",["CODE",{},"$HIR"]," token 3 on whoever you hit."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"2"],"\n",["TD",{},"—"],"\n",["TD",{},"0"],"\n",["TD",{},"0 in every capture; 0/1/7 gave byte-identical behaviour. Inert."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"3"],"\n",["TD",{},"HP"],"\n",["TD",{},"45"],"\n",["TD",{},"Starting/max HP. Echoed as ",["CODE",{},"$LCD"]," token 1 after ",["CODE",{},"$SPAWN"],"."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"4"],"\n",["TD",{},"armor"],"\n",["TD",{},"70"],"\n",["TD",{},"Armor pool (",["CODE",{},"$LCD"]," token 2, ",["CODE",{},"$HP"]," token 2)."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"5"],"\n",["TD",{},"shield"],"\n",["TD",{},"70"],"\n",["TD",{},"Shield ",["STRONG",{},"maximum"],". The pool starts at 0 and only fills via an IR ",["CODE",{},"$SIR"]," grant function — it is not BLE-writable as a value."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"6"],"\n",["TD",{},"—"],"\n",["TD",{},"50"],"\n",["TD",{},"— (unknown)"],"\n",["TD",{},"—"],"\n"],"\n",["TR",{},"\n",["TD",{},"7"],"\n",["TD",{},"(empty)"],"\n",["TD",{},"—"],"\n",["TD"],"\n",["TD",{},"—"],"\n"],"\n",["TR",{},"\n",["TD",{},"8+"],"\n",["TD",{},["STRONG",{},"positional voice pack"]],"\n",["TD",{},"H44 JAD V33 V3I V3C V3G V3E V37 H06 H55 H13 H21 H02 U15 W71 A10"],"\n",["TD",{},"Sixteen sound ids on the wire. The app's metadata declares these voice-pack fields: deathAlarm, stealthDeathScream, musicMixOnDeath, deathScream, battleRespawnCry, meleeGrunt, shortPain, longPain, painRelief, missShothit, hitHp, hitArrmor, hitShield, hitCrit, emptyUnboundButtonSound, ammoOrGearPickUp, energyShieldLoop. Which wire slot carries which name: — (unknown)."],"\n",["TD",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]],"\n"],"\n"]]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §3, §7e, §7p, §7r; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/callsign-extract/protocol-classes.md","rel":"noopener"},"protocol/callsign-extract/protocol-classes.md"]," (PSET); ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/mcp/brx_mcp/gameconfig.py","rel":"noopener"},"mcp/brx_mcp/gameconfig.py"],"; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/unknowns.md","rel":"noopener"},"docs/unknowns.md"]," (A10b′, P3)"]],"\n",["SECTION",{"class":"blk blk-callout co-tip","data-type":"callout"},["ASIDE",{"class":"callout tip","role":"note","id":"numbering-a-fleet-is-one-token"},["STRONG",{"class":"co-title"},"Numbering a fleet is one token."],["P",{},"Give every gun a distinct ",["CODE",{},"$PSET"]," token 1 at arm time and per-player kill attribution is BLE-native — no cable, no IR receiver. Show operators 1-based ids; write ",["CODE",{},"id − 1"],"."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7p, §7q"]]],"\n\n"],"\n  "],"\n  ",["ASIDE",{"class":"toc","aria-label":"On this page"},["DIV",{"class":"toc-in"},["P",{"class":"toc-h"},"On this page"],["OL",{},["LI",{},["A",{"href":"#gset-validated-against-the-captured-gset-0-0-1-0-1-0-50-1","class":"active"},"$GSET,<t1>,…,<t8>, — validated against the captured $GSET,0,0,1,0,1,0,50,1,"]],["LI",{},["A",{"href":"#there-is-no-respawn-time-lives-or-score-token"},"There is no respawn, time, lives or score token."]],["LI",{},["A",{"href":"#pset-sample-pset-6-0-45-70-70-50-h44-jad-v33-v3i-v3