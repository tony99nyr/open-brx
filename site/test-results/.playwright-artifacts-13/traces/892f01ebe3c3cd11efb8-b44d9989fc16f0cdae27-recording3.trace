are"]]," Built + software-tested"],["LI",{},["SPAN",{"class":"badge b-spec","title":"Specified only"},["I",{"aria-hidden":"true"},"📐"],["SPAN",{},"spec"]]," Specified only"],["LI",{},["SPAN",{"class":"badge b-wip","title":"Under construction"},["I",{"aria-hidden":"true"},"🚧"],["SPAN",{},"under construction"]]," Under construction"]],["P",{},"Nothing unconfirmed is published — see ",["A",{"href":"/credits/"},"Credits & sourcing"],"."]],"\n"],"\n",["SECTION",{"class":"blk blk-hero","data-type":"hero"},["P",{"class":"hero-text"},"Headline: \"One text protocol, three ways in.\" Sub: The BRX speaks a plain ASCII, comma-delimited command language on a hardware UART. Gen1 exposes it over Bluetooth Classic, Gen2/3 over BLE, and the community drives it from a wire — the frames are identical on all three. Background: DEV-01."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §1, §7c"]],"\n",["SECTION",{"class":"blk blk-callout co-info","data-type":"callout"},["ASIDE",{"class":"callout info","role":"note","id":"who-found-this"},["STRONG",{"class":"co-title"},"Who found this."],["P",{},"Protocol discovery for the BRX platform is the work of ",["STRONG",{},"LaserTagMods"]," (JEDGE / JBOX). This page restates their findings independently, with our own bench verification noted per row."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," (header, §7d), README.md"]]],"\n",["SECTION",{"class":"blk blk-table","data-type":"table"},["H2",{"id":"transport-by-generation"},"Transport by generation"],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"Generation"],"\n",["TH",{},"Link"],"\n",["TH",{},"Speed"],"\n",["TH",{},"How you connect"],"\n",["TH",{},"Confidence"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},"Gen1"],"\n",["TD",{},"Bluetooth Classic (SPP)"],"\n",["TD",{},"57600 baud"],"\n",["TD",{},"Pair an HC-05 module (PIN ",["CODE",{},"0001"],", master role). The headset must be connected for Bluetooth to function."],"\n",["TD",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"Gen2/3"],"\n",["TD",{},"BLE — Nordic UART Service (NUS)"],"\n",["TD",{},"UART bridge at 115200 behind the radio"],"\n",["TD",{},"Connect from any BLE central: laptop (bleak), ESP32, phone. No pairing/PIN."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"Any"],"\n",["TD",{},"Hardware UART inside the gun"],"\n",["TD",{},"115200"],"\n",["TD",{},"What JEDGE drives directly (",["CODE",{},"Serial1"],"). No external accessory port exists on the BRX — a wired tap means opening the gun. Untested by us."],"\n",["TD",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"Any"],"\n",["TD",{},"Micro-USB \"Programing Port\""],"\n",["TD",{},"USB CDC (baud ignored)"],"\n",["TD",{},["STRONG",{},"Not"]," the ",["CODE",{},"$"]," protocol — a separate ",["CODE",{},"QUERY"],"/",["CODE",{},"SETUP"]," console. See the Serial console page."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]],"/"],"\n",["TD"],"\n",["TD"],"\n",["TD"],"\n",["TD"],"\n"],"\n"]]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §1, §7c"]],"\n",["SECTION",{"class":"blk blk-spec-sheet","data-type":"spec-sheet"},["H2",{"id":"ble-nordic-uart-service-uuids"},"BLE — Nordic UART Service UUIDs"],["DL",{},["DT",{},"Service: ",["CODE",{},"6E400001-B5A3-F393-E0A9-E50E24DCCA9E"]],["DD"],["DT",{},"RX characteristic (",["STRONG",{},"write"]," to tagger): ",["CODE",{},"6E400002-B5A3-F393-E0A9-E50E24DCCA9E"]],["DD"],["DT",{},"TX characteristic (",["STRONG",{},"notify"]," from tagger): ",["CODE",{},"6E400003-B5A3-F393-E0A9-E50E24DCCA9E"]],["DD"],["DT",{},"Advertised name: ",["CODE",{},"Tactix-XXXX"]," (the last two bytes of the BLE MAC). The NUS service UUID ",["STRONG",{},"is"]," present in the advertisement, so scan-time generation detection works."],["DD"],["DT",{},"ATT MTU negotiates to ",["STRONG",{},"23 bytes"]," — chunk writes to ~20-byte payloads; this is required, not defensive."],["DD"],["DT",{},["CODE",{},"$PING,*"]," → ",["CODE",{},"$PONG,*"]," round trip ≈ 59 ms over BLE."],["DD"]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §1, §7a, §7b; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/mcp/brx_mcp/protocol.py","rel":"noopener"},"mcp/brx_mcp/protocol.py"]]],"\n",["SECTION",{"class":"blk blk-callout co-tip","data-type":"callout"},["ASIDE",{"class":"callout tip","role":"note","id":"generation-detection-heuristic"},["STRONG",{"class":"co-title"},"Generation detection heuristic."],["P",{},"Power on the tagger and run a BLE scan. If it advertises the UART service → Gen2/3. If nothing appears on BLE but the device pairs over Bluetooth Classic → Gen1."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §1"]]],"\n",["SECTION",{"class":"blk blk-diagram","data-type":"diagram"},["FIGURE",{"class":"fig fig-svg fig-pending","id":"DEV-02","style":"--ratio:16/9"},["DIV",{"class":"ph ph-svg","role":"img","aria-label":"Link topology. Boxes: HOST (laptop/phone/ESP32) — TAGGER — HEADSET — OTHER TAGGER — USB CONSOLE. Arrows: host→tagger labelled \"BLE NUS write 6E400002\" and tagger→host \"notify 6E400003\"; a dashed bidirectional line tagger↔headset labelled \"proprietary link (team colour, hit sensors)\"; tagger→other tagger a dotted amber arrow labelled \"IR 38 kHz, 25-bit word\"; a side arrow USB CONSOLE→tagger labelled \"QUERY / SETUP (CR-terminated, not $)\". A small note on the Gen1 path: \"Gen1: SPP 57600 via HC-05\"."},["SPAN",{"class":"ph-id"},"DEV-02"],["SPAN",{"class":"ph-kind"},"diagram pending"]],["FIGCAPTION",{},"Link topology: host ↔ BLE NUS ↔ tagger ↔ (proprietary link) headset; tagger → IR → other tagger; USB console on the side."]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §1, §7c, §7r"]],"\n",["SECTION",{"class":"blk blk-bit-field","data-type":"bit-field"},["H2",{"id":"frame-anatomy"},"Frame anatomy"],["P",{"class":"lead"},"(render as an annotated string, not bits)"],["DIV",{"class":"bitfield"},["P",{},["CODE",{},"$"]," + ",["CODE",{},"COMMAND"]," + (",["CODE",{},","]," + token)* + ",["CODE",{},",*"]],"\n",["UL",{},"\n",["LI",{},"ASCII, comma-delimited tokens. Starts with ",["CODE",{},"$COMMAND"],", ends with ",["CODE",{},",*"],"."],"\n",["LI",{},["STRONG",{},"Empty tokens are legal and meaningful"]," — consecutive commas mean \"leave unchanged / not applicable\". ",["CODE",{},"$SPAWN,,*"]," (one empty token) is a different command from ",["CODE",{},"$SPAWN,*"],"."],"\n",["LI",{},"Example: ",["CODE",{},"$PING,*"]," → reply ",["CODE",{},"$PONG,*"],"."],"\n",["LI",{},"Tokens may not contain a comma, ",["CODE",{},"*"]," or a line break (that is the validator in ",["CODE",{},"protocol.py"],": ",["CODE",{},"^\\$[A-Z0-9!]+(,[^,*\\r\\n]*)*,\\*$"],")."],"\n",["LI",{},"Notifications can arrive merged (",["CODE",{},"$ALCD,…$BUT,0,1,*"],"); split on the next ",["CODE",{},"$"]," as well as on ",["CODE",{},"*"],"."],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §2, §7e; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/mcp/brx_mcp/protocol.py","rel":"noopener"},"mcp/brx_mcp/protocol.py"]]],"\n",["SECTION",{"class":"blk blk-diagram","data-type":"diagram"},["FIGURE",{"class":"fig fig-svg fig-pending","id":"DEV-03","style":"--ratio:16/9"},["DIV",{"class":"ph ph-svg","role":"img","aria-label":"Annotated frame `$PLAY,,4,6,V3A,,,,*` as monospace chips: `$` (start), `PLAY` (command), `,` separators, an **empty** token highlighted in amber with the note \"empty = leave unchanged\", `4`, `6`, `V3A` (announcer slot), trailing empties, `,*` (terminator). Callouts: \"max ~20-byte BLE chunks\", \"no commas / * / newlines inside tokens\"."},["SPAN",{"class":"ph-id"},"DEV-03"],["SPAN",{"class":"ph-kind"},"diagram pending"]],["FIGCAPTION",{},"Annotated frame anatomy."]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §2"]],"\n",["SECTION",{"class":"blk blk-steps","data-type":"steps"},["H2",{"id":"waking-a-gun-and-holding-the-link"},"Waking a gun and holding the link"],["DIV",{"class":"steps"},["OL",{},"\n",["LI",{},"Connect and subscribe to the TX notify characteristic. Establishing a link succeeds roughly ",["STRONG",{},"1 attempt in 3"]," (the official app behaves the same); retry — that ",["EM",{},"is"]," the fix."],"\n",["LI",{},"On a ",["STRONG",{},"fresh power-up"],", send ",["CODE",{},"$STOP,*"]," then ",["CODE",{},"$PHONE,*"]," (after a power-cycle ",["CODE",{},"$PHONE,*"]," alone wakes it). A just-booted gun ignores a bare ",["CODE",{},"$VERSION,*"]," until then."],"\n",["LI",{},["CODE",{},"$PHONE,*"]," opens the ",["STRONG",{},"event tap"],": the gun says \"phone connected\", answers ",["CODE",{},"$BUT,3,0,*"],", streams button events and ",["CODE",{},"$VOLTS"]," telemetry, and locks its on-gun menu until a game is configured or it is power-cycled."],"\n",["LI",{},"Idle taggers are ",["STRONG",{},"silent"],": outside app mode no unsolicited messages are sent — no button, trigger or hit traffic."],"\n",["LI",{},"The official app's connect ritual (captured, fw v4.32) is ",["CODE",{},"$STOP,*"]," → ",["CODE",{},"$PLAYX,0,*"]," → ",["CODE",{},"$VOL,69,0,*"]," → ",["CODE",{},"$PLAY,VA20,3,6,,,,,*"]," (\"connection established\"), then once per session ",["CODE",{},"$NAME,<name>,*"]," + ",["CODE",{},"$VERSION,*"],". It never sends ",["CODE",{},"$PHONE,*"],"."],"\n",["LI",{},["STRONG",{},"The headset must be linked"]," or the gun will connect, answer a quick ",["CODE",{},"$PING"],", then drop within seconds and echo nothing to config. After a gun-initiated ",["CODE",{},"$DISCONNECT,*"],", back off ≥ 5 s before reconnecting."],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7a, §7b, §7m, §7r; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/gotchas.md","rel":"noopener"},"docs/gotchas.md"]]],"\n",["SECTION",{"class":"blk blk-callout co-warn","data-type":"callout"},["ASIDE",{"class":"callout warn","role":"note","id":"the-safety-model"},["STRONG",{"class":"co-title"},"The safety model."],["P",{},"Three layers, in order of what they protect: (1) firmware is never written, so ",["STRONG",{},"a power-cycle always restores a tagger"],"; (2) a host should refuse malformed frames and require an explicit confirm for any command outside the ",["STRONG",{},"known-safe list"]," (below); (3) the ",["STRONG",{},"panic sequence"]," ",["CODE",{},"$CLEAR,*"]," then ",["CODE",{},"$SP,99,*"]," returns a gun to a sane state. Battle Company's official USB updater is the factory-restore path."],["P",{"class":"src"},["SPAN",{},"Source:"]," README.md \"Safety\", ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §8, ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/mcp/brx_mcp/protocol.py","rel":"noopener"},"mcp/brx_mcp/protocol.py"]]]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-python"},"# The known-safe list enforced by brx-mcp (mcp/brx_mcp/protocol.py).\n# Everything else needs confirm=True — that is the host's safety rail, not a tagger limit.\nKNOWN_SAFE_COMMANDS = {\n    \"PING\", \"CLEAR\", \"START\", \"SPAWN\", \"CONNECT\", \"INIT\", \"PHONE\",\n    \"GSET\", \"PSET\", \"WEAP\", \"SIR\", \"BMAP\", \"GLED\", \"PLAY\", \"AS\", \"SP\",\n    \"PBWEAP\", \"PBTEAM\", \"PBPERK\", \"TID\",\n    # sent by the official iOS app during a normal captured game:\n    \"AMMO\", \"STOP\", \"PLAYX\", \"VOL\", \"HLED\", \"NAME\", \"VERSION\", \"HLOOP\",\n    \"SFLASH\",\n}\nPANIC_SEQUENCE = [\"$CLEAR,*\", \"$SP,99,*\"]\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/mcp/brx_mcp/protocol.py","rel":"noopener"},"mcp/brx_mcp/protocol.py"]]],"\n",["SECTION",{"class":"blk blk-callout co-warn","data-type":"callout"},["ASIDE",{"class":"callout warn","role":"note","id":"volume"},["STRONG",{"class":"co-title"},"Volume."],["P",{},["CODE",{},"$VOL,30"]," is kind to ears on a bench but ",["STRONG",{},"measurably inaudible for weapon and game audio"],"; ",["CODE",{},"$VOL,45"]," is barely audible. Use ",["STRONG",{},"69"]," (the iOS app's value) for real play."],["P",{"class":"src"},["SPAN",{},"Source:"]," CLAUDE.md hard rules; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §3 ($VOL)"]]],"\n",["SECTION",{"class":"blk blk-faq","data-type":"faq"},["DIV",{"class":"faq"},["DETAILS",{},["SUMMARY",{},"Is the baud rate real over BLE?"],["DIV",{},["P",{},"No — BLE has no baud. 115200 is the UART behind the radio bridge, which is why BLE and a wire speak identical frames."],"\n"]],["DETAILS",{},["SUMMARY",{},"Why does my client drop at ~6.6 s?"],["DIV",{},["P",{},"The link ",["EM",{},"holds"]," fine once up (80 s+ sessions with the official app, multi-minute sessions with ours). Establishment is intermittent; retry in a loop. If it dies within seconds ",["EM",{},"and echoes nothing to config"],", the headset is not linked."],"\n"]],["DETAILS",{},["SUMMARY",{},"Can a command brick the gun?"],["DIV",{},["P",{},"Nothing in the protocol writes firmware. Every state written over BLE is wiped by a power-cycle (except ",["CODE",{},"$NAME"],", which persists)."],"\n"]]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7c · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7b, §7e, §7r · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7r, ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-24 $NAME)"]],"\n\n"],"\n  "],"\n  ",["ASIDE",{"class":"toc","aria-label":"On this page"},["DIV",{"class":"toc-in"},["P",{"class":"toc-h"},"On this page"],["OL",{},["LI",{},["A",{"href":"#who-found-this"},"Who found this."]],["LI",{},["A",{"href":"#transport-by-generation"},"Transport by generation"]],["LI",{},["A",{"href":"#ble-nordic-uart-service-uuids"},"BLE — Nordic UART Service UUIDs"]],["LI",{},["A",{"href":"#generation-detection-heuristic"},"Generation detection heuristic."]],["LI",{},["A",{"href":"#frame-anatomy"},"Frame anatomy"]],["LI",{},["A",{"href":"#waking-a-gun-and-holding-the-link"},"Waking a gun and holding the link"]],["LI",{},["A",{"href":"#the-safety-model"},"The safety model."]],["LI",{},["A",{"href":"#volume"},"Volume."]]]]],"\n"],"\n",["FOOTER",{"class":"foot"},"\n  ",["P",{},"Protocol discovered by ",["A",{"href":"https://github.com/LaserTagMods","rel":"noopener"},"LaserTagMods"]," (JEDGE / JBOX) · Hardware by Battle Company · Fixes by the owner community."],"\n  ",["P",{},"Open BRX is an independent open-source project and is not affiliated with or endorsed by Battle Company. MIT licence. ",["A",{"href":"/credits/"},"Credits & sourcing"]," · ",["A",{"href":"/changelog/"},"Changelog"]," · ",["A",{"href":"/llms.txt"},"llms.txt"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx","rel":"noopener"},"GitHub"]],"\n"],"\n",["DIV",{"class":"search-modal","data-search-modal":"","hidden":""},["DIV",{"class":"search-box","role":"dialog","aria-label":"Search"},["INPUT",{"__playwright_value_":"","type":"search","data-search-input":"","placeholder":"Search pages, headings, weapons, sound ids, commands…","autocomplete":"off"}],["DIV",{"class":"search-results","data-search-results":"","aria-live":"polite"},["P",{"class":"muted"},"Type to search."]],["P",{"class":"search-hint"},"Esc to close"]]],"\n","\n\n"]],"viewport":{"width":390,"height":844},"timestamp":47478.111,"wallTime":1787863199938,"collectionTime":8.400000095367432,"resourceOverrides":[],"isMainFrame":true}}
