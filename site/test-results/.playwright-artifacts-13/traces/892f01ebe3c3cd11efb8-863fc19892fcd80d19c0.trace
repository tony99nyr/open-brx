ds over USB"]],["LI",{},["A",{"href":"/manual/sound/firmware/"},"Firmware updates & factory restore"]],["LI",{},["A",{"href":"/manual/sound/volume/"},"Volume"]]]],["DETAILS",{"class":"side-sec","open":""},["SUMMARY",{},["SPAN",{"class":"num"},"05"]," Fix, mod & accessorise"],["UL",{},["LI",{},["A",{"href":"/manual/fix/"},"Overview"]],["LI",{},["A",{"href":"/manual/fix/diagnose/"},"Diagnose my tagger"]],["LI",{},["A",{"href":"/manual/fix/pairing/"},"Headset, pairing & Bluetooth"]],["LI",{},["A",{"href":"/manual/fix/hits-sound-battery/"},"Hits, sound & battery"]],["LI",{},["A",{"href":"/manual/fix/repairs/"},"Repairs"]],["LI",{},["A",{"href":"/manual/fix/mods/"},"Mods"]],["LI",{},["A",{"href":"/manual/fix/accessories/","aria-current":"page"},"Accessories"]],["LI",{},["A",{"href":"/manual/fix/community/"},"The community"]],["LI",{},["A",{"href":"/manual/fix/faq/"},"FAQ"]]]],["DETAILS",{"class":"side-sec"},["SUMMARY",{},["SPAN",{"class":"num"},"06"]," Developer reference"],["UL",{},["LI",{},["A",{"href":"/manual/dev/"},"Overview"]],["LI",{},["A",{"href":"/manual/dev/transport/"},"Transport, framing & safety"]],["LI",{},["A",{"href":"/manual/dev/commands/"},"Command reference"]],["LI",{},["A",{"href":"/manual/dev/arm-sequence/"},"The arm sequence — from $CLEAR to a live gun"]],["LI",{},["A",{"href":"/manual/dev/weap/"},"$WEAP — the weapon definition"]],["LI",{},["A",{"href":"/manual/dev/gset-pset/"},"$GSET and $PSET — game and player settings"]],["LI",{},["A",{"href":"/manual/dev/sir/"},"$SIR — the incoming-IR effects matrix"]],["LI",{},["A",{"href":"/manual/dev/events/"},"Events — what the gun tells you"]],["LI",{},["A",{"href":"/manual/dev/ir/"},"The IR word — what a shot carries through the air"]],["LI",{},["A",{"href":"/manual/dev/serial-console/"},"The USB serial console — QUERY and SETUP"]],["LI",{},["A",{"href":"/manual/dev/headset-link/"},"Headset, link and what survives"]],["LI",{},["A",{"href":"/manual/dev/brx-mcp/"},"Getting started with brx-mcp"]],["LI",{},["A",{"href":"/manual/dev/captures/"},"Captures — recording and decoding the official app"]]]]],"\n  ",["MAIN",{"id":"main","class":"main"},"\n    ",["NAV",{"class":"crumbs","aria-label":"Breadcrumb"},["A",{"href":"/"},"Home"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/"},"Manual"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/fix/"},"Fix, mod & accessorise"],["SPAN",{"class":"sep"},"/"],["SPAN",{"aria-current":"page"},"Accessories"]],"\n    ",["ARTICLE",{"class":"page"},"\n",["HEADER",{"class":"page-head"},"\n",["H1",{},"Accessories"],"\n",["P",{"class":"subtitle"},"Grenade, stations, headsets, power and mounts — what each is, and the gotchas nobody tells you."],"\n",["P",{"class":"meta"},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]],["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]],["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]],["SPAN",{"class":"lv"},"Last verified ",["TIME",{"datetime":"2026-08-27"},"2026-08-27"]],["A",{"class":"md-link","href":"/manual/fix/accessories.md"},"View as Markdown"]],"\n",["DETAILS",{"class":"legend"},["SUMMARY",{},"What the badges mean"],["UL",{},["LI",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," Verified on our bench"],["LI",{},["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]," Official Battle Company docs"],["LI",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," Decoded from the Callsign app"],["LI",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]," Community-reported"],["LI",{},["SPAN",{"class":"badge b-software","title":"Built + software-tested"},["I",{"aria-hidden":"true"},"🧪"],["SPAN",{},"software"]]," Built + software-tested"],["LI",{},["SPAN",{"class":"badge b-spec","title":"Specified only"},["I",{"aria-hidden":"true"},"📐"],["SPAN",{},"spec"]]," Specified only"],["LI",{},["SPAN",{"class":"badge b-wip","title":"Under construction"},["I",{"aria-hidden":"true"},"🚧"],["SPAN",{},"under construction"]]," Under construction"]],["P",{},"Nothing unconfirmed is published — see ",["A",{"href":"/credits/"},"Credits & sourcing"],"."]],"\n"],"\n",["SECTION",{"class":"blk blk-cards","data-type":"cards"},["H2",{"id":"smart-grenade"},"Smart grenade"],["DIV",{"class":"cards"},["UL",{},"\n",["LI",{},["STRONG",{},"What it is:"]," a portable objective device — button on top, three IR emitters, an emitter+receiver, status LEDs, USB-C charging. Flashes green at power-up = ready. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]],["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n",["LI",{},["STRONG",{},"Five button-set modes, by LED colour:"]," red = Frag (thrown blast), green = Assault, blue = Hill (King of the Hill), yellow = Respawn, white = CTF. Set by holding the top button ~4 s (long beep), cycling while it beeps, releasing on the colour; the LED goes white to confirm the lock. Mode persists across power cycles; boot flashes the current mode's colour for ~1 s. ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n",["LI",{},["STRONG",{},"Pairing is only for thrown use:"]," boot the gun holding RIGHT (\"install accessory\"), shoot the grenade within its 30 s window, pair all accessories in one session. Objective modes need ",["STRONG",{},"no pairing"]," — any gun interacts by IR. ",["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]],["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n",["LI",{},["STRONG",{},"Respawn-station gotcha:"]," each tagger must ",["EM",{},"receive"]," the station's IR (pre-game exposure or a grenade-button press mid-game) to switch from self-respawn to station-respawn. A tagger that never got it just self-respawns. Stations can be overtaken. ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]],["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n",["LI",{},["STRONG",{},"Known quirks:"]," no winner display for its own KotH/domination modes; Assault can be captured by the defending team by accident; the mode cannot be set from an app — it is button-locked on the device. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]],["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n",["LI",{},"Credit: Jay's two 2019 grenade videos are the de-facto manual; our reference extends them with bench findings. → full grenade page in ",["EM",{},"Gameplay"],"."],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/grenade.md","rel":"noopener"},"docs/reference/grenade.md"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/brx-extended-user-guide.md","rel":"noopener"},"docs/reference/brx-extended-user-guide.md"]," (Accessory / grenade pairing)"]],"\n",["SECTION",{"class":"blk blk-image","data-type":"image"},["FIGURE",{"class":"fig fig-photo fig-pending","id":"FIX-09","style":"--ratio:16/9"},["DIV",{"class":"ph ph-photo","role":"img","aria-label":"The smart grenade in hand, top button and status LED visible, LED lit in one mode colour"},["SPAN",{"class":"ph-id"},"FIX-09"],["SPAN",{"class":"ph-kind"},"photo pending"]],["FIGCAPTION",{},"The smart grenade in hand, top button and status LED visible, LED lit in one mode colour"]]],"\n",["SECTION",{"class":"blk blk-cards","data-type":"cards"},["H2",{"id":"other-ir-paired-accessories-official"},"Other IR-paired accessories (official)"],["DIV",{"class":"cards"},["UL",{},"\n",["LI",{},["STRONG",{},"Hatchet, shield, sidearm, extra grenades"]," — all pair to a specific gun over IR with the same \"install accessory\" boot so only the owner can trigger them; re-pair everything together whenever you add one. Hatchet, shield and sidearm firmware updates the same way as the gun (PROGRAM button at power-on → disk mode). ",["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/brx-extended-user-guide.md","rel":"noopener"},"docs/reference/brx-extended-user-guide.md"]]],"\n",["SECTION",{"class":"blk blk-cards","data-type":"cards"},["H2",{"id":"utility-boxes-stations"},"Utility boxes & stations"],["DIV",{"class":"cards"},["UL",{},"\n",["LI",{},["STRONG",{},"JBOX family (LaserTagMods / Jay):"]," IR \"smart bases\" that a player shoots to capture and that emit IR back to heal, boost, respawn or damage. Modes: single- and multi-point domination (time / shots / damage-weighted), tug-of-war, Ultimate King of the Hill (up to 21 boxes, roles reshuffled every round), battle royale with storm and checkpoints, loot/weapon pickups, proximity mine, gas, alarm. Configured from a phone browser on the box's WiFi hotspot; ",["STRONG",{},"JBOX Mini"]," is the minimal ESP32 + IR rx/tx + one RGB LED, USB-powered. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n",["LI",{},["STRONG",{},"JHALO:"]," a spare BRX headset plus an ESP32 becomes a respawn/utility box — reuses gear you own. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n",["LI",{},["STRONG",{},"Measured radio ranges (Jay, obstructed trail):"]," ESP-NOW ~250 ft (~580 ft with an external antenna); LoRa standard mode ~1,370 ft with zero loss but ~3.5 s round trip. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/jay-ecosystem.md","rel":"noopener"},"docs/reference/jay-ecosystem.md"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/lasertagmods.md","rel":"noopener"},"docs/reference/lasertagmods.md"]]],"\n",["SECTION",{"class":"blk blk-table","data-type":"table"},["H2",{"id":"headset-variants"},"Headset variants"],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"Headset"],"\n",["TH",{},"Notes"],"\n",["TH",{},"Confidence"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},"v1"],"\n",["TD",{},"Slide-out battery compartment"],"\n",["TD",{},["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"v2"],"\n",["TD",{},"Single 18650 cell; same hardware as the Battle Rifle Pro headset, firmware differs; 3 W green hit LEDs on four sides plus WS2812B RGB"],"\n",["TD",{},["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]],["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"\"Gen-3\" pairing"],"\n",["TD",{},"Uses the button-hold + RIGHT-at-boot \"PAIRING MODE\" procedure"],"\n",["TD",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"SwapTX headset (mod)"],"\n",["TD",{},"~$50, 18650, unlocks on-tagger hosting; ",["STRONG",{},"no IR emitters"],"; dimmer LEDs in sun; beta"],"\n",["TD",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"All"],"\n",["TD",{},"Pairs automatically at power-on (up to 3 min); won't pair in target mode; goes dark during play; rainbow = disconnected"],"\n",["TD",{},["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]],["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n"]]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/brx-extended-user-guide.md","rel":"noopener"},"docs/reference/brx-extended-user-guide.md"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/community-notes.md","rel":"noopener"},"docs/reference/community-notes.md"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," 2026-08-27"]],"\n",["SECTION",{"class":"blk blk-spec-sheet","data-type":"spec-sheet"},["H2",{"id":"batteries-chargers"},"Batteries & chargers"],["DL",{},["DT",{},"Gun pack: 7.4 V ~2200 mAh Li-ion, 2-pin connector, ",["STRONG",{},"reversed polarity vs. convention"]," ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],["DD"],["DT",{},"Gun charger: 8.4 V two-cell smart charger; LED red → green; ~2–4 h ",["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]],["DD"],["DT",{},"Headset: single 18650 (v2); any 5 V USB charger ",["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]],["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],["DD"],["DT",{},"Runtime: ~8 h play per charge ",["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]],["DD"],["DT",{},"Alternative: 6×AA tray, ",["STRONG",{},"non-rechargeable only"]," ",["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]],["DD"],["DT",{},"Spares: charge outside the gun via a spliced BRX AC adapter; keep a stack and swap ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],["DD"],["DT",{},"Rider power: USB power bank on the bracket (5000 mAh ≈ 15 h of JEDGE); tagger port OK under 300 mA ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],["DD"]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/brx-manual-notes.md","rel":"noopener"},"docs/reference/brx-manual-notes.md"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/brx-extended-user-guide.md","rel":"noopener"},"docs/reference/brx-extended-user-guide.md"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/community-notes.md","rel":"noopener"},"docs/reference/community-notes.md"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/reference/lasertagmods.