{"type":"before","callId":"call@102","startTime":46676.853,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n      const c = document.querySelector('main').cloneNode(true);\n      c.querySelectorAll('pre, code').forEach(e => e.remove());\n      return c.innerText;\n    }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@31","pageId":"page@a0c7dd165655b46c0c3acea63b378bf4","beforeSnapshot":"before@call@102"}
