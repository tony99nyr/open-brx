d":"main","class":"main"},"\n    ",["NAV",{"class":"crumbs","aria-label":"Breadcrumb"},["A",{"href":"/"},"Home"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/"},"Manual"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/fix/"},"Fix, mod & accessorise"],["SPAN",{"class":"sep"},"/"],["SPAN",{"aria-current":"page"},"FAQ"]],"\n    ",["ARTICLE",{"class":"page"},"\n",["HEADER",{"class":"page-head"},"\n",["H1",{},"FAQ"],"\n",["P",{"class":"subtitle"},"The questions owners ask first."],"\n",["P",{"class":"meta"},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]],["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]],["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]],["SPAN",{"class":"lv"},"Last verified ",["TIME",{"datetime":"2026-08-27"},"2026-08-27"]],["A",{"class":"md-link","href":"/manual/fix/faq.md"},"View as Markdown"]],"\n",["DETAILS",{"class":"legend"},["SUMMARY",{},"What the badges mean"],["UL",{},["LI",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," Verified on our bench"],["LI",{},["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]," Official Battle Company docs"],["LI",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," Decoded from the Callsign app"],["LI",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]," Community-reported"],["LI",{},["SPAN",{"class":"badge b-software","title":"Built + software-tested"},["I",{"aria-hidden":"true"},"🧪"],["SPAN",{},"software"]]," Built + software-tested"],["LI",{},["SPAN",{"class":"badge b-spec","title":"Specified only"},["I",{"aria-hidden":"true"},"📐"],["SPAN",{},"spec"]]," Specified only"],["LI",{},["SPAN",{"class":"badge b-wip","title":"Under construction"},["I",{"aria-hidden":"true"},"🚧"],["SPAN",{},"under construction"]]," Under construction"]],["P",{},"Nothing unconfirmed is published — see ",["A",{"href":"/credits/"},"Credits & sourcing"],"."]],"\n"],"\n",["SECTION",{"class":"blk blk-faq","data-type":"faq"},["DIV",{"class":"faq"},["DETAILS",{},["SUMMARY",{},"Why won't my gun fire?"],["DIV",{},["P",{},"Check the headset first: it's off, unpaired (slow rainbow blink) or dropped mid-game, and the firmware locks the trigger. Link it, or re-pair. Second most common: the game hasn't started (pull the reload handle) or you're dead. ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]],["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]],["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"How do I re-pair a headset?"],["DIV",{},["P",{},"Headset on, hold its small button, boot the tagger holding RIGHT, wait for \"PAIRING MODE\", pull the trigger once (\"HEADSET CONNECTED\") and once more (\"device paired\"). ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"The headset went dark once the game started — is it broken?"],["DIV",{},["P",{},"No. Team colour shows pre-game only; dark during play is native. Rainbow is the fault state. ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"Can I put custom sounds on the tagger?"],["DIV",{},["P",{},"Yes. Hold SELECT while powering on with the programming port plugged into a computer; a drive appears with an ",["CODE",{},"AUDIO"]," folder — replace the ",["CODE",{},".LTP"]," files (slow: ~1 h per 250 MB). Keep the originals. ",["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]],["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"Which phones work with the official app?"],["DIV",{},["P",{},"Callsign works on Android 10 and older, not on newer Android. On any phone the headset must be linked or the app disconnects. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]],["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"What battery and charger does it take?"],["DIV",{},["P",{},"A 7.4 V ~2200 mAh Li-ion pack with an 8.4 V two-cell smart charger; the headset charges from any 5 V USB. Optional 6×AA — non-rechargeable only. ",["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]],["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"Is the battery polarity really reversed?"],["DIV",{},["P",{},"Yes — reversed from the usual convention. Meter any replacement pack before plugging it in. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"Why is my gun called Tactix2 again?"],["DIV",{},["P",{},"Opening the official app resets the owner-set name. Rename it and power-cycle. ",["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"Why do guns fail after about an hour of hosted play?"],["DIV",{},["P",{},"\"Screamers\": a documented failure of taggers left powered and hosted for long sessions, plus a firmware rule that refuses Bluetooth re-pairing below a battery threshold. Power-rest guns, rotate them, keep batteries topped. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]],["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"Do I have to open the gun for JEDGE?"],["DIV",{},["P",{},"No. It rides on the phone bracket with its own power; stock firmware is never touched. The Open BRX Companion is designed the same way. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"Can I change the grenade's mode from an app?"],["DIV",{},["P",{},"No — it's set only by the button-hold on the device, and it stays set across power cycles. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]],["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"]],["DETAILS",{},["SUMMARY",{},"Where do I get 3D-print files?"],["DIV",{},["P",{},"There is no public BRX library yet; the reload-button STL circulates in the owners' group. Open BRX is building an open, versioned one. ",["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"]]],["P",{"class":"src"},["SPAN",{},"Source:"]," pages above"]],"\n\n"],"\n  "],"\n  \n"],"\n",["FOOTER",{"class":"foot"},"\n  ",["P",{},"Protocol discovered by ",["A",{"href":"https://github.com/LaserTagMods","rel":"noopener"},"LaserTagMods"]," (JEDGE / JBOX) · Hardware by Battle Company · Fixes by the owner community."],"\n  ",["P",{},"Open BRX is an independent open-source project and is not affiliated with or endorsed by Battle Company. MIT licence. ",["A",{"href":"/credits/"},"Credits & sourcing"]," · ",["A",{"href":"/changelog/"},"Changelog"]," · ",["A",{"href":"/llms.txt"},"llms.txt"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx","rel":"noopener"},"GitHub"]],"\n"],"\n",["DIV",{"class":"search-modal","data-search-modal":"","hidden":""},["DIV",{"class":"search-box","role":"dialog","aria-label":"Search"},["INPUT",{"__playwright_value_":"","type":"search","data-search-input":"","placeholder":"Search pages, headings, weapons, sound ids, commands…","autocomplete":"off"}],["DIV",{"class":"search-results","data-search-results":"","aria-live":"polite"},["P",{"class":"muted"},"Type to search."]],["P",{"class":"search-hint"},"Esc to close"]]],"\n","\n\n"]],"viewport":{"width":390,"height":844},"timestamp":46641.631,"wallTime":1787863199102,"collectionTime":17.799999952316284,"resourceOverrides":[],"isMainFrame":true}}
