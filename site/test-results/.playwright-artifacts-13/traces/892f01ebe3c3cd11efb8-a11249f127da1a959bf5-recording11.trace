{"type":"frame-snapshot","snapshot":{"callId":"call@469","snapshotName":"before@call@469","pageId":"page@e95a01c439c3703d54a77c05e4c22564","frameId":"frame@85ea8c2284ef1f88f9db16b6c170662f","frameUrl":"http://localhost:4173/manual/dev/serial-console/","doctype":"html","html":["HTML",{"lang":"en","data-theme":""},[[7,24]],[[7,25]],["BODY",{"class":""},[[7,26]],[[7,28]],[[7,29]],[[7,65]],[[7,66]],["DIV",{"class":"layout has-side has-toc"},[[7,67]],[[7,284]],[[7,285]],["MAIN",{"id":"main","class":"main"},[[7,286]],[[7,301]],[[7,302]],["ARTICLE",{"class":"page"},[[7,303]],["HEADER",{"class":"page-head"},[[7,304]],[[2,0]],[[7,312]],[[7,317]],[[7,318]],["P",{"class":"meta"},[[7,323]],[[7,328]],["SPAN",{"class":"lv"},[[7,329]],["TIME",{"datetime":"2026-08-27"},[[7,330]]]],[[7,334]]],[[7,336]],[[7,394]],[[7,395]]],[[7,397]],[[7,429]],[[7,430]],[[7,574]],[[7,575]],[[7,589]],[[7,590]],[[7,632]],[[7,633]],[[7,705]],[[7,706]],[[7,722]],[[7,723]],[[7,767]],[[7,768]]],[[7,770]]],[[7,772]],[[7,789]],[[7,790]]],[[7,792]],[[7,814]],[[7,815]],[[7,823]],[[7,824]],[[7,825]]]],"viewport":{"width":390,"height":844},"timestamp":54351.785,"wallTime":1787863206813,"collectionTime":0.9000000953674316,"resourceOverrides":[],"isMainFrame":true}}
