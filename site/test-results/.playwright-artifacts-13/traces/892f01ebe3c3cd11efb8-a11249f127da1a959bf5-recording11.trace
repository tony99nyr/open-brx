v/brx-mcp/"},"Getting started with brx-mcp"]],["LI",{},["A",{"href":"/manual/dev/captures/"},"Captures — recording and decoding the official app"]]]]],"\n  ",["MAIN",{"id":"main","class":"main"},"\n    ",["NAV",{"class":"crumbs","aria-label":"Breadcrumb"},["A",{"href":"/"},"Home"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/"},"Manual"],["SPAN",{"class":"sep"},"/"],["A",{"href":"/manual/dev/"},"Developer reference"],["SPAN",{"class":"sep"},"/"],["SPAN",{"aria-current":"page"},"The USB serial console — QUERY and SETUP"]],"\n    ",["ARTICLE",{"class":"page"},"\n",["HEADER",{"class":"page-head"},"\n",["H1",{},"The USB serial console — ",["CODE",{},"QUERY"]," and ",["CODE",{},"SETUP"]],"\n",["P",{"class":"subtitle"},"The micro-USB \"Programing Port\" is a Teensy serial console with two commands, not the ",["CODE",{},"$"]," protocol and not SSH"],"\n",["P",{"class":"meta"},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]],["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]],["SPAN",{"class":"lv"},"Last verified ",["TIME",{"datetime":"2026-08-27"},"2026-08-27"]],["A",{"class":"md-link","href":"/manual/dev/serial-console.md"},"View as Markdown"]],"\n",["DETAILS",{"class":"legend"},["SUMMARY",{},"What the badges mean"],["UL",{},["LI",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]," Verified on our bench"],["LI",{},["SPAN",{"class":"badge b-official","title":"Official Battle Company docs"},["I",{"aria-hidden":"true"},"📖"],["SPAN",{},"official"]]," Official Battle Company docs"],["LI",{},["SPAN",{"class":"badge b-apk","title":"Decoded from the Callsign app"},["I",{"aria-hidden":"true"},"🔍"],["SPAN",{},"app"]]," Decoded from the Callsign app"],["LI",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]," Community-reported"],["LI",{},["SPAN",{"class":"badge b-software","title":"Built + software-tested"},["I",{"aria-hidden":"true"},"🧪"],["SPAN",{},"software"]]," Built + software-tested"],["LI",{},["SPAN",{"class":"badge b-spec","title":"Specified only"},["I",{"aria-hidden":"true"},"📐"],["SPAN",{},"spec"]]," Specified only"],["LI",{},["SPAN",{"class":"badge b-wip","title":"Under construction"},["I",{"aria-hidden":"true"},"🚧"],["SPAN",{},"under construction"]]," Under construction"]],["P",{},"Nothing unconfirmed is published — see ",["A",{"href":"/credits/"},"Credits & sourcing"],"."]],"\n"],"\n",["SECTION",{"class":"blk blk-callout co-info","data-type":"callout"},["ASIDE",{"class":"callout info","role":"note"},["P",{},"The BRX has two ports: charging, and a separate micro-USB ",["STRONG",{},"\"Programing Port\""],". Plugged into a computer it enumerates as a ",["STRONG",{},"Teensyduino USB Serial"]," CDC device (Windows ",["CODE",{},"COMx"],", macOS ",["CODE",{},"/dev/tty.usbmodem*"],", Linux ",["CODE",{},"/dev/ttyACM*"],", VID ",["CODE",{},"16C0"],"). Baud is ignored. This is what the community means by \"PuTTY into the tagger\". The command set came from LaserTagMods' headset-pairing note."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7c; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-24 B7)"]]],"\n",["SECTION",{"class":"blk blk-table","data-type":"table"},["H2",{"id":"what-the-port-does-and-does-not-do"},"What the port does and does not do"],["DIV",{"class":"table-wrap"},["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"Sent"],"\n",["TH",{},"Result"],"\n",["TH",{},"Conf"],"\n"],"\n"],"\n",["TBODY",{},["TR",{},"\n",["TD",{},["CODE",{},"$PING,*"],", ",["CODE",{},"$VERSION,*"],", any ",["CODE",{},"$"]," frame"],"\n",["TD",{},["STRONG",{},"Echoed back"]," (local echo on — easy to mistake for a reply); with CR: ",["CODE",{},"ERROR"]],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"?"],", ",["CODE",{},"help"],", ",["CODE",{},"AT"],", ",["CODE",{},"status"],", …"],"\n",["TD",{},["CODE",{},"ERROR"]],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"QUERY"]," + CR"],"\n",["TD",{},"Dumps the device record (below). Case-insensitive."],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"SETUP"]," + CR"],"\n",["TD",{},"Enters factory provisioning; prompts (EN/中文) for the ",["STRONG",{},"headset's"]," serial number"],"\n",["TD",{},["SPAN",{"class":"badge b-bench","title":"Verified on our bench"},["I",{"aria-hidden":"true"},"✅"],["SPAN",{},"bench"]]],"\n"],"\n",["TR",{},"\n",["TD",{},"Hold SELECT while powering on with USB connected"],"\n",["TD",{},"Mass-storage mode exposing the on-board sound storage (the sound-pack update path) — a different mode from the console"],"\n",["TD",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]],"\n"],"\n"]]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7c; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/callsign-extract/protocol-classes.md","rel":"noopener"},"protocol/callsign-extract/protocol-classes.md"]," (\"New sounds ON THE TAGGER\")"]],"\n",["SECTION",{"class":"blk blk-code","data-type":"code"},["PRE",{},["CODE",{"class":"language-text"},"QUERY\nGun Info\nGun Version: v4.32\nSerial Number/Head PIN: <SERIAL>      <- matches the sticker on the paired headset\nGun Name: Tactix2                     <- the field $NAME writes\nHeadset Version: hds.59               <- reads '?' briefly after a power-cycle until the headset re-handshakes\nGun: 7.671 VOLTS\nPlayerID 0                            <- device-level player id (separate from the per-game $PSET id)\nFieldID1\nNRFhost 1\nNRFslave 1\ndevHost 1                             <- developer/host image, not retail\nHead: 3.837 VOLTS                     <- headset battery\nHead Tested:\nHead BURN in test: 0\nGun BURN in test: 3hours28minutes\nGrenade Pin: <PIN>\nLaser: 16.9 mW\nPCB-5\nBTchip- 4\nBT central V: devhost.03\n"],["BUTTON",{"type":"button","class":"copy-btn","aria-label":"Copy code"},"copy"]],"\n",["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7c (values are one unit's; PIN/serial redacted)"]],"\n",["SECTION",{"class":"blk blk-callout co-tip","data-type":"callout"},["ASIDE",{"class":"callout tip","role":"note","id":"real-format-quirks"},["STRONG",{"class":"co-title"},"Real-format quirks"],["P",{},"the parser has to survive: ",["CODE",{},"Gun Name"]," is NUL-padded, lines end ",["CODE",{},"\\r\\r\\n"],", ",["CODE",{},"Laser"]," can read ",["CODE",{},"UNTESTED"]," instead of a number, ",["CODE",{},"Grenade Pin"]," is a real non-zero value. ",["CODE",{},"brx-mcp"]," ships ",["CODE",{},"parse_query()"]," and ",["CODE",{},"python -m brx_mcp usb-query [port]"],", which saves a backup to ",["CODE",{},"~/.brx-mcp/device-backups/"],"."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-24 B7); ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/mcp/brx_mcp/protocol.py","rel":"noopener"},"mcp/brx_mcp/protocol.py"]]]],"\n",["SECTION",{"class":"blk blk-steps","data-type":"steps"},["H2",{"id":"setup-the-provisioning-re-pair-path-identity-lives-here"},["CODE",{},"SETUP"]," — the provisioning/re-pair path (identity lives here)"],["DIV",{"class":"steps"},["OL",{},"\n",["LI",{},"Run ",["CODE",{},"QUERY"]," on both gun and headset-side records first; ",["CODE",{},"SETUP"]," on the gun asks for the ",["STRONG",{},"headset's"]," serial number — that is the gun↔headset pairing mechanism."],"\n",["LI",{},"The \"Factory Defaults\" banner is a ",["STRONG",{},"mode header, not an action"],": entering ",["CODE",{},"SETUP"]," and power-cycling out changed nothing (field-by-field diff)."],"\n",["LI",{},["SPAN",{"class":"badge b-community","title":"Community-reported"},["I",{"aria-hidden":"true"},"👥"],["SPAN",{},"community"]]," The community's \"change tagger ID / re-pair the headset\" procedure is this console (LaserTagMods' headset-pairing note); the identity fields it concerns are the ones ",["CODE",{},"QUERY"]," prints: ",["CODE",{},"PlayerID"],", ",["CODE",{},"FieldID"],", ",["CODE",{},"Serial Number/Head PIN"],", ",["CODE",{},"Grenade Pin"],"."],"\n",["LI",{},"Only the first prompt (the headset serial) has been walked on our bench. Do it only on a gun you can afford to re-pair."],"\n",["LI",{},"For per-game identity you do not need this: ",["CODE",{},"$PSET"]," token 1 over BLE sets the player id each game."],"\n"],"\n"],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7c, §7p; ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-24)"]],"\n",["SECTION",{"class":"blk blk-callout co-warn","data-type":"callout"},["ASIDE",{"class":"callout warn","role":"note","id":"firmware-backup-is-impossible-do-not-reflash"},["STRONG",{"class":"co-title"},"Firmware backup is impossible; do not reflash."],["P",{},"Teensy's HalfKay bootloader is write-only by design, so no image can be read back. Rollback depends entirely on Battle Company supplying the original image. The official app's version gate (supports \"until v2.01e\") is an ",["EM",{},"upper"]," bound; it warns and still runs a game."],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/protocol/brx-protocol.md","rel":"noopener"},"protocol/brx-protocol.md"]," §7b, §7c"]]],"\n",["SECTION",{"class":"blk blk-faq","data-type":"faq"},["DIV",{"class":"faq"},["DETAILS",{},["SUMMARY",{},"Is ",["CODE",{},"$QUERY,*"]," over BLE the same thing?"],["DIV",{},["P",{},"No. Over BLE it returns a ",["CODE",{},"$"],"-framed status array with no serial, PIN or version. The device record is USB-only."],"\n"]],["DETAILS",{},["SUMMARY",{},"What is the advertised BLE name vs ",["CODE",{},"Gun Name"],"?"],["DIV",{},["P",{},"Two fields: the advertisement is ",["CODE",{},"Tactix-XXXX"]," from the MAC tail; ",["CODE",{},"Gun Name"]," is what ",["CODE",{},"$NAME"]," writes."],"\n"]]],["P",{"class":"src"},["SPAN",{},"Source:"]," ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-24) · ",["A",{"href":"https://github.com/tony99nyr/open-brx/blob/main/docs/experiment-log.md","rel":"noopener"},"docs/experiment-log.md"]," (2026-08-24)"]],"\n\n"],"\n  "],"\n  ",["ASIDE",{"class":"toc","aria-label":"On this page"},["DIV",{"class":"toc-in"},["P",{"class":"toc-h"},"On this page"],["OL",{},["LI",{},["A",{"href":"#what-the-port-does-and-does-not-do"},"What the port does and does not do"]],["LI",{},["A",{"href":"#real-format-quirks"},"Real-format quirks"]],["LI",{},["A",{"href":"#setup-the-provisioning-re-pair-path-identity-lives-here"},"SETUP — the provisioning/re-pair path (identity lives here)"]],["LI",{},["A",{"href":"#firmware-backup-is-impossible-do-not-reflash"},"Firmware backup is impossible; do not reflash."]]]]],"\n"],"\n",["FOOTER",{"class":"foot"},"\n  ",["P",{},"Protocol discovered by ",["A",{"href":"https://github.com/LaserTagMods","rel":"noopener"},"LaserTagMods"]," (JEDGE / JBOX) · Hardware by Battle Company · Fixes by the owner community."],"\n  ",["P",{},"Open BRX is an independent open-source project and is not affiliated with or endorsed by Battle Company. MIT licence. ",["A",{"href":"/credits/"},"Credits & sourcing"]," · ",["A",{"href":"/changelog/"},"Changelog"]," · ",["A",{"href":"/llms.txt"},"llms.txt"]," · ",["A",{"href":"https://github.com/tony99nyr/open-brx","rel":"noopener"},"GitHub"]],"\n"],"\n",["DIV",{"class":"search-modal","data-search-modal":"","hidden":""},["DIV",{"class":"search-box","role":"dialog","aria-label":"Search"},["INPUT",{"__playwright_value_":"","type":"search","data-search-input":"","placeholder":"Search pages, headings, weapons, sound ids, commands…","autocomplete":"off"}],["DIV",{"class":"search-results","data-search-results":"","aria-live":"polite"},["P",{"class":"muted"},"Type to search."]],["P",{"class":"search-hint"},"Esc to close"]]],"\n","\n\n"]],"viewport":{"width":390,"height":844},"timestamp":54322.096,"wallTime":1787863206782,"collectionTime":7.5,"resourceOverrides":[],"isMainFrame":true}}
