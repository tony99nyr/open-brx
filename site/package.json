{
  "name": "open-brx-site",
  "private": true,
  "type": "module",
  "description": "Static generator for the Open BRX website: renders docs/platform/*.md and docs/manual/*.md into webapp/ (Cloudflare assets).",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node serve.mjs",
    "test": "playwright test",
    "test:only": "playwright test --grep",
    "shots": "node shots.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "@playwright/test": "^1.62.1"
  },
  "dependencies": {
    "marked": "^18.0.11"
  }
}
