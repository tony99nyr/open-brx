        "mcp/brx_mcp/modes/*.py"
      ],
      "outputs": [
        "mcp/brx_mcp/mc/weapons.json"
      ],
      "write": [
        "{python}",
        "mcp/tools/gen_weapon_ttk.py"
      ],
