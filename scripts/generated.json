      ],
      "reason": "derive_callsign_data: reads raw Callsign APK assets (Sounds.json, game-medals-config.json) that live only in a local gitignored folder, so a fresh checkout cannot rerun it."
    },
    {
      "generator": "mcp/tools/fw_commands.py",
