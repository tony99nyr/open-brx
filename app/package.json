{
  "name": "brx-companion-app",
  "version": "0.1.5",
  "private": true,
  "description": "BRX native BLE app (Capacitor) — Android + iOS from one codebase",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=iife --outfile=www/app.js && esbuild src/utility.js --bundle --format=iife --outfile=www/utility.js",
    "test": "node --test \"test/*.test.mjs\"",
    "sync": "npm run build && npx cap sync",
    "ios:setup": "npm run build && ./scripts/ios-setup.sh",
    "ios:open": "npx cap open ios",
    "android:setup": "npm run build && ./scripts/android-setup.sh",
    "android:apk": "./scripts/android-apk.sh",
    "ui:shots": "node tools/shots.mjs",
    "ui:e2e": "node tools/e2e.mjs",
    "ui:rig": "node tools/rig.mjs",
    "ui:scenarios": "node tools/scenarios.mjs",
    "ui:moments": "npm run build && node tools/moments.mjs",
    "ui:stage": "npm run build && node tools/stage.mjs",
    "ui:screens": "npm run build && node tools/screens.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/camera-preview": "^8.0.1",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "capacitor-zeroconf": "^4.0.0",
    "jsqr": "^1.4.0",
    "brx-beacon": "file:plugins/brx-beacon"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1"
  }
}
