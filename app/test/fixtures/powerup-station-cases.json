        {"t": 60200, "do": "taken", "player": 0, "expect": {"available": false, "updates": []}},
        {"t": 120000, "do": "tick", "expect": {"available": true, "updates": [{"id": 4, "available": true, "next_spawn_in_ms": 60000}]}}
      ] },
      "steps": [
