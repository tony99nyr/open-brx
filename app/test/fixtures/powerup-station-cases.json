        {"t": 1100, "do": "tick", "players": [{"id": 7, "state": ["alive", "claim_ready"], "value": 4}], "expect": {"advert": {"state": 0, "value": 60, "taker": 7}}},
        {"t": 1200, "do": "update", "body": {"available": true, "next_spawn_in_ms": 59800}, "expect": {"advert": {"state": 0, "value": 60, "taker": 7}}},
