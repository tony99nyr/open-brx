        {"t": 0, "do": "tick", "expect": {"available": false}},
        {"t": 185000, "do": "tick", "expect": {"available": true, "updates": [{"id": 4, "available": true, "next_spawn_in_ms": 55000}]}},
        {"t": 185000, "do": "taken", "player": 0, "age_ms": 6000, "expect": {"available": true, "updates": []}},
        {"t": 185000, "do": "taken", "player": 0, "age_ms": 4000, "expect": {"available": false, "taken_by": 0, "feed_took": 1, "updates": [{"id": 4, "available": false, "next_spawn_in_ms": 55000}]}}
      ] }
    },
    {
      "name": "a taker number outside 1 to 63 still takes the item but is never credited by number",
      "only": ["mc"],
      "setup": {"id": 4, "spawn_every_s": 60},
      "mc": { "item_spawn_every_s": 60, "steps": [
        {"t": 60000, "do": "tick", "expect": {"available": true}},
        {"t": 60100, "do": "taken", "player": 0, "player_num": 64, "expect": {"available": false, "taken_by": null, "feed_took": 1, "feed_has": ["A PLAYER TOOK OVERSHIELD"], "feed_lacks": ["PLAYER 64"]}},
        {"t": 120000, "do": "tick", "expect": {"available": true}},
        {"t": 120100, "do": "taken", "player": 0, "player_num": 0, "expect": {"available": false, "taken_by": null, "feed_took": 2, "feed_lacks": ["PLAYER 0"]}},
        {"t": 180000, "do": "tick", "expect": {"available": true}},
        {"t": 180100, "do": "taken", "player": 0, "player_num": true, "expect": {"available": false, "taken_by": null, "feed_took": 3, "feed_lacks": ["PLAYER 1 ", "PLAYER TRUE"]}}
      ] }
    },
    {
      "name": "a negative or boolean age_ms is ignored: the take is dated by its arrival, not by a made-up age",
      "only": ["mc"],
      "setup": {"id": 4, "spawn_every_s": 60},
      "mc": { "item_spawn_every_s": 60, "steps": [
        {"t": 60000, "do": "tick", "expect": {"available": true}},
        {"t": 60000, "do": "taken", "player": 0, "age_ms": true, "expect": {"available": false, "taken_by": 0}},
        {"t": 120000, "do": "tick", "expect": {"available": true}},
        {"t": 120000, "do": "taken", "player": 1, "age_ms": -5000, "expect": {"available": false, "taken_by": 1}}
      ] }
    },
    {
      "name": "a restart keeps a taken item taken and the fixed schedule going",
      "only": ["mc"],
      "setup": {"id": 4, "spawn_every_s": 60},
      "mc": { "item_spawn_every_s": 60, "steps": [
        {"t": 61000, "do": "tick", "expect": {"available": true}},
        {"t": 61100, "do": "taken", "player": 0, "expect": {"available": false}},
        {"t": 70000, "do": "restart"},
        {"t": 70000, "do": "hello", "expect": {"available": false, "taken_by": 0, "updates": [{"id": 4, "available": false, "next_spawn_in_ms": 50000}]}},
        {"t": 120000, "do": "tick", "expect": {"available": true, "updates": [{"id": 4, "available": true, "next_spawn_in_ms": 60000}]}}
      ] }
    },
    {
      "name": "a take after the match ended, after NEXT MATCH, or about another match changes nothing",
      "only": ["mc"],
      "setup": {"id": 4, "spawn_every_s": 60},
      "mc": { "item_spawn_every_s": 60, "steps": [
        {"t": 60000, "do": "tick", "expect": {"available": true}},
        {"t": 60100, "do": "pickup", "player": 0, "match_id": "stale", "expect": {"available": true, "feed_took": 0, "updates": []}},
        {"t": 60200, "do": "end"},
        {"t": 60300, "do": "taken", "player": 0, "expect": {"feed_took": 0, "updates": []}},
        {"t": 60400, "do": "pickup", "player": 0, "expect": {"feed_took": 0, "updates": []}},
        {"t": 60500, "do": "next_match"},
        {"t": 60600, "do": "taken", "player": 0, "expect": {"feed_took": 0, "updates": []}},
        {"t": 60700, "do": "pickup", "player": 0, "expect": {"feed_took": 0, "updates": []}}
      ] }
    },
    {
      "name": "a pickup dated in the future is dated by its arrival: it takes this spawn and not the next",
      "only": ["mc"],
      "setup": {"id": 4, "spawn_every_s": 60},
      "mc": { "item_spawn_every_s": 60, "steps": [
        {"t": 60000, "do": "tick", "expect": {"available": true}},
        {"t": 60100, "do": "pickup", "player": 0, "fact_t": 150000, "expect": {"available": false, "taken_by": 0}},
        {"t": 120000, "do": "tick", "expect": {"available": true, "updates": [{"id": 4, "available": true, "next_spawn_in_ms": 60000}]}}
      ] }
    },
    {
      "name": "the console reset: refused with no item or outside a match, else the item is there now and the feed says so",
      "only": ["mc"],
      "setup": {"id": 4, "spawn_every_s": 60},
      "mc": { "item_spawn_every_s": 60, "steps": [
        {"t": 60000, "do": "tick", "expect": {"available": true}},
        {"t": 60100, "do": "taken", "player": 0, "expect": {"available": false}},
        {"t": 60200, "do": "reset_api", "node": "nobody", "expect": {"refused": "nobody"}},
        {"t": 60300, "do": "reset_api", "expect": {"available": true, "taken_by": null, "feed_has": ["OPERATOR RESET \u00b7 STATION #4"], "updates": [{"id": 4, "available": true, "next_spawn_in_ms": 59700, "reset": true}]}},
        {"t": 60400, "do": "end"},
        {"t": 60500, "do": "reset_api", "expect": {"refused": "RECAP"}}
      ] }
    },
    {
      "name": "a weapon item follows the same schedule and dedupe (Rockets, 120 s)",
      "only": ["mc"],
      "setup": {"id": 4, "spawn_every_s": 120},
      "mc": { "item_spawn_every_s": 120, "item_preset": "rockets", "steps": [
        {"t": 119999, "do": "tick", "expect": {"available": false}},
        {"t": 120000, "do": "tick", "expect": {"available": true, "updates": [{"id": 4, "available": true, "next_spawn_in_ms": 120000}]}},
        {"t": 120100, "do": "pickup", "player": 0, "expect": {"available": false, "taken_by": 0, "feed_took": 1, "feed_has": ["TOOK ROCKETS \u00b7 STATION #4"], "updates": [{"id": 4, "available": false, "next_spawn_in_ms": 119900}]}},
        {"t": 120200, "do": "taken", "player": 1, "expect": {"taken_by": 1, "feed_took": 1, "feed_has": ["P1 TOOK ROCKETS"], "updates": []}}
      ] }
    }
  ]
