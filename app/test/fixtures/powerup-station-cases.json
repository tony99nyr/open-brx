        {"t": 60100, "do": "taken", "player": 0, "expect": {"available": false, "updates": [{"id": 4, "available": false, "next_spawn_in_ms": 59900}]}},
        {"t": 60200, "do": "taken", "player": 0, "expect": {"available": false, "updates": []}},
        {"t": 120000, "do": "tick", "expect": {"available": true, "updates": [{"id": 4, "available": true, "next_spawn_in_ms": 60000}]}}
      ] },
      "steps": [
        {"t": 0, "do": "update", "body": {"available": false, "next_spawn_in_ms": 1000}},
        {"t": 1000, "do": "tick", "players": [], "expect": {"events": ["spawned"]}},
        {"t": 1100, "do": "tick", "players": [{"id": 7, "state": ["alive", "claim_ready"], "value": 4}], "expect": {"advert": {"state": 0, "value": 60, "taker": 7}}},
        {"t": 1200, "do": "update", "body": {"available": true, "next_spawn_in_ms": 59800}, "expect": {"advert": {"state": 0, "value": 60, "taker": 7}}},
        {"t": 61000, "do": "tick", "players": [], "expect": {"advert": {"state": 1, "value": 0, "taker": 0}, "events": ["spawned"]}}
      ]
    },
    {
      "name": "a claim with no known next spawn advertises value 0 (the station does not know yet), not an invented countdown",
      "setup": {"id": 4, "spawn_every_s": 60},
      "steps": [
        {"t": 0, "do": "update", "body": {"available": true}},
        {"t": 1000, "do": "tick", "players": [{"id": 7, "state": ["alive", "claim_ready"], "value": 4}], "expect": {"advert": {"state": 0, "value": 0, "taker": 7}}},
        {"t": 30000, "do": "advance", "expect": {"advert": {"state": 0, "value": 0, "taker": 7}}}
      ]
    },
    {
      "name": "the countdown never reads 0 while the item is taken",
      "setup": {"id": 4, "spawn_every_s": 60},
      "steps": [
        {"t": 0, "do": "update", "body": {"available": true, "next_spawn_in_ms": 1000}},
        {"t": 500, "do": "tick", "players": [{"id": 7, "state": ["alive", "claim_ready"], "value": 4}], "expect": {"advert": {"state": 0, "value": 1, "taker": 7}}},
