      "mc": { "item_spawn_every_s": 60, "steps": [
        {"t": 1000, "do": "taken", "player": 0, "expect": {"available": false, "taken_by": null, "feed_took": 0, "updates": []}},
        {"t": 60000, "do": "tick", "expect": {"available": true}},
