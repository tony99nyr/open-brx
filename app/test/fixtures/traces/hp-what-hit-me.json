{
  "name": "hp-what-hit-me",
  "why": "S56 'what hit me': with the shooter's loadout on the roster, a magnitude-20 hit is ambiguous (the HUD lists both, the fact names nothing), a magnitude-9 hit names the assault rifle (fact and HUD), and a killing blow whose magnitude is the whole pool held (the overkill clamp) names the weapon this shooter was resolved to this life, not the catalogue pickup that shares the magnitude. A hit whose magnitude equals the whole pool but does not kill is no clamp: it names the pickup.",
  "source": "app/test/what-hit-me.test.mjs; app/src/engine.js `_onHp`",
  "runners": ["engine","stage"],
  "setup": {
    "delay": "timers",
    "fields": ["moment"]
  },
  "steps": [
    {"advance_ms":10},
    {"advance_ms":3000},
    {"check":"live","preamble":true},
    {"mc":{"kind":"assign","body":{"player":{"player_id":"p1","player_num":7,"display":"REAPER","team_id":"blue","loadout":{"weapons":[{"weapon_id":"assault_rifle"},{"weapon_id":"shotgun"}]},"voice":"male"},"team":{"team_id":"blue","name":"BLUE","color":"blue","tid":1},"roster":[{"player_id":"p1","player_num":7,"display":"REAPER","team_id":"blue"},{"player_id":"p2","player_num":19,"display":"VIPER","team_id":"yellow","weapons":[{"weapon_id":"assault_rifle","hir":[9]},{"weapon_id":"shotgun","hir":[20]},{"weapon_id":"smg","hir":[20]}]}],"catalog":{"weapons":[{"weapon_id":"amr","name":"AMR","hir":[86,65]}]}}}},
    {"frames":["$HIR,4,0,19,2,20,0,3,*","$HP,45,50,0,*"]},
    {"check":"ambiguous"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,9,0,3,*","$HP,45,41,0,*"]},
    {"check":"named"},
    {"advance_ms":1000},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,86,0,3,*","$HP,45,20,0,*"]},
    {"check":"whole_pool_magnitude_not_lethal"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,65,0,3,*","$HP,0,0,0,*"]},
    {"check":"clamped_kill"}
  ],
  "stage_ignores": [
    {"what":"write:$HLOOP,1,","why":"Harness timing: the down rearm waits 2.5 s on the stage's instant `sleep` but on the engine's clock (both use `rearm_after_ms`), so it lands at a different checkpoint."},
    {"what":"write:$IRTX","why":"DIVERGENCE: the stage does not model the S57 IR callouts. A dying engine sends the kill-confirm and DOWN words over `$IRTX` from inside `_death` (engine.js, the `S57 IR callout` write); the stage sends nothing."},
    {"what":"write:$GLED","why":"Harness timing: the stage's gun-body readout animation runs on its injected `sleep`, which is instant in this runner, while the engine's runs on its tick clock, so the same frames land at different checkpoints."},
    {"what":"state.moment","why":"The stage has no HUD moment slot to expose as state (its `_moment` is an internal gate); the HUD reads the engine's."},
    {"what":"state.deaths","why":"The stage keeps no death count (MC and the HUD read the engine's); `alive` is compared instead."},
    {"what":"state.phase","why":"The stage has no MC link, so it has no match phase; it is armed and spawned by its own buttons."}
  ],
