{
  "name": "hp-armour-spill",
  "why": "Standard pools (45/70/0): an armour-only hit, a hit that spills armour into health, a resend of the same pools (no damage), the low-health alert edge with its debounce, a follow-up hit that restarts the quiet time, the alert line going out, and a second hit under the threshold that does not fire it again.",
  "source": "app/test/engine.test.mjs low-health tests (A17.2, F57, F375); app/src/engine.js `_onHp`",
  "runners": ["engine","stage"],
  "setup": {
    "delay": "timers",
    "fields": ["moment"]
  },
  "steps": [
    {"advance_ms":10},
    {"advance_ms":3000},
    {"check":"live","preamble":true},
    {"frames":["$HIR,4,0,19,2,9,0,3,*","$HP,45,61,0,*"]},
    {"check":"armour_hit"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,40,0,3,*","$HP,36,0,0,*"]},
    {"check":"spill_into_health"},
    {"frames":["$HP,36,0,0,*"]},
    {"check":"resend_no_damage"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,25,0,3,*","$HP,11,0,0,*"]},
    {"check":"low_health_crossed"},
    {"advance_ms":250},
    {"frames":["$HIR,4,0,19,2,2,0,3,*","$HP,9,0,0,*"]},
    {"check":"hit_restarts_quiet"},
    {"advance_ms":1500},
    {"check":"alert_sent"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,2,0,3,*","$HP,7,0,0,*"]},
    {"check":"second_hit_under_threshold"},
    {"advance_ms":1000},
    {"frames":["$HP,30,0,0,*"]},
    {"check":"healed"},
    {"frames":["$HP,30,40,0,*"]},
    {"check":"armour_up"},
    {"frames":["$HP,4545,7070,0,*"]},
    {"check":"rise_over_ceiling"}
  ],
  "stage_ignores": [
    {"what":"checkpoint:rise_over_ceiling:writes","why":"DIVERGENCE: an out-of-range `$HP` (above the pool ceiling, which the gun never sends). The engine keeps the value the gun reports; the stage clamps it to its ceiling, so its readout writes differ too."},
    {"what":"state.armor","at":"rise_over_ceiling","why":"DIVERGENCE: an out-of-range `$HP` (above the pool ceiling, which the gun never sends). The engine keeps the value the gun reports; the stage clamps it to its ceiling."},
    {"what":"state.hp","at":"rise_over_ceiling","why":"DIVERGENCE: an out-of-range `$HP` (above the pool ceiling, which the gun never sends). The engine keeps the value the gun reports; the stage clamps it to its ceiling."},
    {"what":"write:$HLED,7,4,90","why":"Harness timing: the low-health headset frame travels with the held low-health line, so it lands at a different checkpoint for the same reason (instant stage `sleep`)."},
    {"what":"write:$PLAY,,4,6,VA86","why":"Harness timing: the low-health line is held HURT_DEBOUNCE (engine.js) on a clock the runner advances for the engine, but the stage waits on its injected `sleep`, which is instant here, so the line lands at a different checkpoint. The hold itself is pinned in test_stage_mirror.py."},
    {"what":"write:$GLED","why":"Harness timing: the stage's gun-body readout animation runs on its injected `sleep`, which is instant in this runner, while the engine's runs on its tick clock, so the same frames land at different checkpoints."},
    {"what":"state.moment","why":"The stage has no HUD moment slot to expose as state (its `_moment` is an internal gate); the HUD reads the engine's."},
    {"what":"state.deaths","why":"The stage keeps no death count (MC and the HUD read the engine's); `alive` is compared instead."},
    {"what":"state.phase","why":"The stage has no MC link, so it has no match phase; it is armed and spawned by its own buttons."}
  ],
