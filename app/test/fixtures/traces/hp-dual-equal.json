{
  "name": "hp-dual-equal",
  "why": "Equal dual-emitter pairs: a slow pair exactly 150 ms apart is one shot_group, and so is a fast pair (cycle 100 ms): its values match the row's body then headset. A different crit, a different shooter, a word with no dual row, two equal words that match no row value, and an off-row value followed by the row value each start a new group.",
  "source": "app/test/engine.test.mjs shot_group tests; app/src/engine.js `_hpShotGroup` (the `equalDual` test it named was dead code, removed 2026-10-04)",
  "runners": ["engine","stage"],
  "setup": {
    "frames": {"dual_emitters":[{"proto":0,"subtype":0,"body":20,"headset":30,"cycle_ms":700},{"proto":0,"subtype":5,"body":15,"headset":15,"cycle_ms":100},{"proto":0,"subtype":6,"body":12,"headset":12,"cycle_ms":700}]},
    "delay": "timers",
    "tick_ms": 50,
    "fields": ["moment"]
  },
  "steps": [
    {"advance_ms":10},
    {"advance_ms":3000},
    {"check":"live","preamble":true},
    {"frames":["$HIR,4,0,19,2,12,0,6,*","$HP,45,58,0,*"]},
    {"advance_ms":150},
    {"frames":["$HIR,4,0,19,2,12,0,6,*","$HP,45,46,0,*"]},
    {"check":"slow_equal_at_150"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,15,0,5,*","$HP,45,31,0,*"]},
    {"advance_ms":50},
    {"frames":["$HIR,4,0,19,2,15,0,5,*","$HP,45,16,0,*"]},
    {"check":"fast_equal_pairs_by_values"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,12,0,7,*","$HP,45,4,0,*"]},
    {"advance_ms":50},
    {"frames":["$HIR,4,0,19,2,12,0,7,*","$HP,37,0,0,*"]},
    {"check":"no_dual_row"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,5,0,6,*","$HP,32,0,0,*"]},
    {"advance_ms":50},
    {"frames":["$HIR,4,0,19,2,5,0,6,*","$HP,27,0,0,*"]},
    {"check":"equal_values_off_the_row"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,5,0,6,*","$HP,22,0,0,*"]},
    {"advance_ms":50},
    {"frames":["$HIR,4,0,19,2,12,0,6,*","$HP,10,0,0,*"]},
    {"check":"off_row_then_row_value"},
    {"advance_ms":1000},
    {"frames":["$HP,45,70,0,*"]},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,12,0,6,*","$HP,45,58,0,*"]},
    {"advance_ms":50},
    {"frames":["$HIR,4,0,19,2,12,1,6,*","$HP,45,46,0,*"]},
    {"check":"crit_differs"},
    {"advance_ms":1000},
    {"frames":["$HIR,4,0,19,2,12,0,6,*","$HP,45,34,0,*"]},
    {"advance_ms":50},
    {"frames":["$HIR,4,0,21,2,12,0,6,*","$HP,45,22,0,*"]},
    {"check":"shooter_differs"}
  ],
  "stage_ignores": [
    {"what":"write:$PLAY,,4,6,VA1G","at":"crit_differs","why":"DIVERGENCE: the stage has no gun audio queue model (engine.js `_gun.freeAt`, `_audioSync`). The engine drops a clip that would wait more than PAIN_STALE_MS behind a playing one, and holds the low-health line until the gun is quiet (F375); the stage plays the clip at once. Porting needs the audio model and the sound-duration table."},
    {"what":"write:$HLED,7,4,90","why":"Harness timing: the low-health headset frame travels with the held low-health line, so it lands at a different checkpoint for the same reason (instant stage `sleep`)."},
    {"what":"write:$PLAY,,4,6,VA86","why":"Harness timing: the low-health line is held HURT_DEBOUNCE (engine.js) on a clock the runner advances for the engine, but the stage waits on its injected `sleep`, which is instant here, so the line lands at a different checkpoint. The hold itself is pinned in test_stage_mirror.py."},
    {"what":"write:$GLED","why":"Harness timing: the stage's gun-body readout animation runs on its injected `sleep`, which is instant in this runner, while the engine's runs on its tick clock, so the same frames land at different checkpoints."},
    {"what":"state.moment","why":"The stage has no HUD moment slot to expose as state (its `_moment` is an internal gate); the HUD reads the engine's."},
    {"what":"state.deaths","why":"The stage keeps no death count (MC and the HUD read the engine's); `alive` is compared instead."},
    {"what":"state.phase","why":"The stage has no MC link, so it has no match phase; it is armed and spawned by its own buttons."}
  ],
