{
  "name": "ammo-stun-snapshot",
  "why": "F15/F259: the stun snapshots the magazine account, so it shows exactly which trigger presses booked a round: a press during a reload, an ALT swap or a heat lockout books none; a press inside the weapon's fire interval books none; a press older than TRIGGER_NO_FIRE_MS is dropped before the next one books. During the stun a heat reading from another slot, or an `$LCD` magazine drop, does not end the active slot's heat lockout.",
  "source": "app/src/engine.js ammo, reload and ALT (engine split (b) coverage)",
  "runners": ["engine","stage"],
  "setup": {
    "catalog": {"weapons":[{"weapon_id":"assault_rifle","name":"AR","reload_s":1.4},{"weapon_id":"shotgun","name":"Shotgun","reload_s":0.4}],"perks":[]},
    "fields": ["switching","reloading","mag","shots","reload","swap","heat","shotCooldown","moment"],
    "config": {"stun":{"duration_s":2}},
    "delay": "timers",
    "stage_sleep": "clock"
  },
  "steps": [
    {"advance_ms":10},
    {"advance_ms":3000},
    {"check":"live","preamble":true},
    {"frames":["$BUT,0,1,*","$ALCD,30,100,0,192,0,*","$BUT,0,0,*"]},
    {"frames":["$BUT,2,1,*","$BUT,2,0,*"]},
    {"frames":["$BUT,0,1,*"]},
    {"frame":"$HIR,4,8,19,2,15,0,0,*"},
    {"check":"press_in_reload"},
    {"advance_ms":2250},
    {"frames":["$ALCD,30,100,0,192,0,*","$ALCD,6,100,1,24,0,*"]},
    {"frames":["$BUT,0,0,*"]},
    {"frame":"$ALCD,32,100,0,162,0,*"},
    {"check":"restored_and_refilled"},
    {"advance_ms":300},
    {"frames":["$BUT,1,1,*","$BUT,1,0,*"]},
    {"frames":["$BUT,0,1,*"]},
    {"frame":"$HIR,4,8,19,2,15,0,0,*"},
    {"check":"press_in_swap"},
    {"advance_ms":2250},
    {"frames":["$ALCD,32,100,0,162,0,*","$ALCD,6,100,1,24,0,*"]},
    {"frames":["$BUT,0,0,*"]},
    {"advance_ms":500},
    {"frames":["$BUT,0,1,*"]},
    {"advance_ms":50},
    {"frames":["$BUT,0,1,*"]},
    {"frame":"$HIR,4,8,19,2,15,0,0,*"},
    {"check":"press_inside_interval"},
    {"advance_ms":2250},
    {"frames":["$ALCD,32,100,0,162,0,*","$ALCD,5,100,1,24,0,*"]},
    {"frames":["$BUT,0,0,*"]},
    {"frames":["$BUT,0,1,*","$BUT,0,0,*"]},
    {"advance_ms":1600},
    {"frames":["$BUT,0,1,*","$BUT,0,0,*"]},
    {"frame":"$HIR,4,8,19,2,15,0,0,*"},
    {"check":"stale_press_dropped"},
    {"advance_ms":2250},
    {"frames":["$ALCD,32,100,0,162,0,*","$ALCD,4,100,1,24,0,*"]},
    {"frames":["$BUT,0,1,*","$ALCD,31,100,0,162,99,*","$BUT,0,0,*"]},
    {"frames":["$BUT,0,1,*"]},
    {"frame":"$HIR,4,8,19,2,15,0,0,*"},
    {"check":"press_in_lockout"},
    {"frame":"$ALCD,0,100,1,0,0,*"},
    {"check":"other_slot_heat_in_stun"},
    {"frame":"$LCD,45,70,0,0,0,0,*"},
    {"check":"lcd_drop_in_stun"},
    {"advance_ms":2250},
    {"check":"restored"}
  ],
  "stage_ignores": [
    {"what":"state.phase","why":"The stage has no MC link, so it has no match phase; it is armed and spawned by its own buttons."},
    {"what":"state.deaths","why":"The stage keeps no death count (MC and the HUD read the engine's); `alive` is compared instead."},
    {"what":"state.moment","why":"The stage has no HUD moment slot to expose as state (its `_moment` is an internal gate); the HUD reads the engine's."},
    {"what":"state.shots","why":"The stage keeps no match shot count: it is the death screen's and MC's stat (engine.js `shots`), and no gun write reads it."},
    {"what":"state.shotCooldown","why":"The ammo gauge's shot-ready cue is HUD display only (test_stage_mirror.py KNOWN_UNMIRRORED `shotCooldown`); the stage draws no gauge."},
    {"what":"state.heat.shown","why":"The OVERHEAT word is HUD display only (KNOWN_UNMIRRORED `am.overheatOnHud`); `heat.heat` and `heat.overheating`, the mechanic, are still compared."},
    {"what":"state.heat.ever","why":"The heat bar's has-heated flag is HUD display only (KNOWN_UNMIRRORED `am.heatedEver`); `heat.heat` and `heat.overheating` are still compared."}
  ],
