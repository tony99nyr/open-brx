    "tick_ms": 50
  },
  "steps": [
    {"advance_ms":10},
    {"advance_ms":3000},
    {"check":"live","preamble":true},
    {"ble":"drop"},
    {"ble":"relink"},
    {"advance_ms":4000},
    {"check":"reconciled"},
    {"frames":["$HIR,4,0,19,2,60,0,3,*","$HP,30,25,0,*"]},
    {"advance_ms":50},
    {"frames":["$HIR,4,0,19,2,40,0,3,*","$HP,12,0,0,*"]},
    {"check":"crossed"},
    {"advance_ms":2000},
    {"check":"steps_landed"}
  ],
