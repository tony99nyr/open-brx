{
  "name": "ammo-recoil-account",
  "why": "F259/S42: rounds the gun reports (the account's drop) step the recoil ladder and write once per state; a release while crisp forgets the burst; a press the gun has not answered holds the writer (`shotInFlight`) until it expires, and a reload and an ALT swap hold it too; a press inside the weapon's fire interval books nothing; melee rounds never step the ladder; an assumed swap re-arms the new weapon's profile; a stun snapshots the account (presses included).",
  "source": "app/src/engine.js the F259 magazine account and the S42 recoil writer's stand-downs (engine split (b) coverage)",
  "runners": ["engine","stage"],
  "setup": {
    "catalog": {"weapons":[{"weapon_id":"assault_rifle","name":"AR","reload_s":1.4,"recoil":{"crisp":100,"degraded":70,"heavy":40,"after_shots":3,"after_heavy":6,"settle_ms":800}},{"weapon_id":"shotgun","name":"Shotgun","reload_s":0.4,"recoil":{"crisp":90,"heavy":50,"after_shots":2,"settle_ms":700}}],"perks":[]},
    "fields": ["switching","reloading","mag","shots","reload","swap","heat","shotCooldown"],
    "config": {"stun":{"duration_s":2}},
    "delay": "timers",
    "stage_sleep": "clock"
  },
