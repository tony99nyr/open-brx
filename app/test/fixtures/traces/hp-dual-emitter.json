    {"check":"live","preamble":true},
    {"frames":["$HIR,4,0,19,2,20,0,0,*","$HP,45,50,0,*"]},
    {"advance_ms":0},
    {"frames":["$HIR,0,0,19,2,20,0,0,*","$HP,45,30,0,*"]},
