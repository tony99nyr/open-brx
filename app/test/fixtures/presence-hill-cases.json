      "why": "Round 2: a dense player at -60 turns sparse at -84 (one advert per 2.5 s). The exit must not wait for the per-advert average to cross: present drops once the debounced window median has stayed under the band for the grace, about 4 s after the dense run stops holding the window.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
