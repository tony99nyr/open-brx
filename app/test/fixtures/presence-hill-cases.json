{
  "version": 1,
  "about": "F440 presence and the kind-5 hill, one statement for three implementations: app/src/beacon.js Presence + app/src/control.js ControlPoint (phone), hardware/m5sticks3/presence.h PlayerPresence + BleControlPoint (Stick), and the stage's reading of the hill advert (mcp/brx_mcp/stage/stage.py). Driven by app/test/presence-hill-cases.test.mjs, hardware/m5sticks3/test/test_presence_cases.cpp and mcp/tests/test_presence_hill_cases.py. Times are ms on one clock. setup holds every number a runner needs, so no runner relies on its own defaults. `players` gives each id its team (tid) and player-advert state names (alive). `sightings` {t,id,rssi} are adverts heard; `series` {id,from_ms,to_ms,every_ms,rssi[]} expands to one sighting per step, cycling the rssi list (a dense advertiser has a short every_ms, a sparse one a long one). A runner feeds every sighting with t <= the tick time, then ticks presence, then updates the hill, every tick_ms from 0 to until_ms. An expect checkpoint (t on a tick) holds `in` (in the circle: present or a credible sighting, the test the hill counts), `present` (dwell passed, debounced exit) per player id, and `hill` {team, state names from held/contested/rising/falling, value}, the three advert bytes the hill sends. A case's `only` lists the implementations that must pass it (default all of phone, stick, stage); `stage` reads only the `hill` advert, because the stage has no presence model of its own. `why` is for the reader.",
  "cases": [
    {
      "name": "lone red player enters at the threshold at once, and is present after the dwell",
      "why": "F440: a binary circle. A credible sighting (median of the last 2 s at or above the threshold) is in the circle before the dwell; present follows after the dwell.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
      "until_ms": 3000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 3000, "every_ms": 250, "rssi": [-75]}],
      "expect": [
        {"t": 0, "in": {"1": true}, "present": {"1": false}, "hill": {"team": 255, "state": [], "value": 0}},
        {"t": 750, "present": {"1": false}, "in": {"1": true}},
        {"t": 1000, "present": {"1": true}, "in": {"1": true}},
        {"t": 2000, "hill": {"team": 0, "state": ["rising"], "value": 20}}
      ]
    },
    {
      "name": "one dB under the threshold never enters",
      "why": "The edge is the threshold itself, never weighted by how far above or below.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
      "until_ms": 6000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 6000, "every_ms": 250, "rssi": [-76]}],
      "expect": [
        {"t": 0, "present": {"1": false}, "in": {"1": false}, "hill": {"team": 255, "state": [], "value": 0}},
        {"t": 3000, "present": {"1": false}, "in": {"1": false}},
        {"t": 6000, "present": {"1": false}, "in": {"1": false}, "hill": {"team": 255, "state": [], "value": 0}}
      ]
    },
    {
      "name": "exit band: a level exactly 3 dB under the threshold stays present",
      "why": "Leaving needs the window median strictly under threshold - band (-78). -78 does not leave, however long.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
      "until_ms": 12000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 2000, "every_ms": 250, "rssi": [-70]}, {"id": 1, "from_ms": 2250, "to_ms": 12000, "every_ms": 250, "rssi": [-78]}],
      "expect": [
        {"t": 2000, "present": {"1": true}},
        {"t": 8000, "present": {"1": true}, "in": {"1": true}},
        {"t": 12000, "present": {"1": true}, "in": {"1": true}, "hill": {"team": 0, "state": ["held"], "value": 100}}
      ]
    },
    {
      "name": "exit grace: below the band for 4 s before present drops",
      "why": "A PRESENT player leaves only after the exit level has stayed under the band for exit_grace_ms.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
      "until_ms": 12000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 2000, "every_ms": 250, "rssi": [-70]}, {"id": 1, "from_ms": 2250, "to_ms": 12000, "every_ms": 250, "rssi": [-79]}],
      "expect": [
        {"t": 2000, "present": {"1": true}},
        {"t": 3000, "present": {"1": true}},
        {"t": 6750, "present": {"1": true}, "in": {"1": true}},
        {"t": 7000, "present": {"1": false}, "in": {"1": false}},
        {"t": 8000, "hill": {"team": 0, "state": [], "value": 68}}
      ]
    },
    {
      "name": "a dip shorter than the grace is not a step out",
      "why": "A 3 s dip to -85 inside a 4 s grace never drops present, and the grace restarts from the next dip.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
      "until_ms": 14000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 2000, "every_ms": 250, "rssi": [-70]}, {"id": 1, "from_ms": 2250, "to_ms": 5000, "every_ms": 250, "rssi": [-85]}, {"id": 1, "from_ms": 5250, "to_ms": 14000, "every_ms": 250, "rssi": [-70]}],
      "expect": [
        {"t": 3500, "present": {"1": true}},
        {"t": 5000, "present": {"1": true}},
        {"t": 7000, "present": {"1": true}},
        {"t": 14000, "present": {"1": true}, "in": {"1": true}, "hill": {"team": 0, "state": ["held"], "value": 100}}
      ]
    },
    {
      "name": "dense noise that only touches the threshold never enters",
      "why": "Review round 2: a dense advertiser's peak at the threshold must not enter, because the sighting is a window median. Every other advert reads -88, and the peak is -74, a dB above the threshold.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
      "until_ms": 10000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 10000, "every_ms": 250, "rssi": [-88, -74]}],
      "expect": [
        {"t": 2000, "present": {"1": false}, "in": {"1": false}, "hill": {"team": 255, "state": [], "value": 0}},
        {"t": 6000, "present": {"1": false}, "in": {"1": false}},
        {"t": 10000, "present": {"1": false}, "in": {"1": false}, "hill": {"team": 255, "state": [], "value": 0}}
      ]
    },
    {
      "name": "a sparse advertiser at the threshold enters on its one advert",
      "why": "The same edge as a dense one: a sparse phone's window holds its single advert, whose median is that advert.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
      "until_ms": 8000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 8000, "every_ms": 2500, "rssi": [-75]}],
      "expect": [
        {"t": 0, "present": {"1": false}, "in": {"1": true}},
        {"t": 1000, "present": {"1": true}, "in": {"1": true}},
        {"t": 8000, "present": {"1": true}, "in": {"1": true}}
      ]
    },
    {
      "name": "the circle edge is the same at a dense and a sparse advert rate",
      "why": "Two players stand at -76 (just out), one dense, one sparse. Neither is ever in the circle.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}, "2": {"team": 1, "state": ["alive"]}},
      "until_ms": 8000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 8000, "every_ms": 100, "rssi": [-76]}, {"id": 2, "from_ms": 0, "to_ms": 8000, "every_ms": 2500, "rssi": [-76]}],
      "expect": [
        {"t": 0, "in": {"1": false, "2": false}},
        {"t": 4000, "in": {"1": false, "2": false}},
        {"t": 8000, "in": {"1": false, "2": false}, "hill": {"team": 255, "state": [], "value": 0}}
      ]
    },
    {
      "name": "a window median ignores one loud outlier",
      "why": "Three adverts inside the 2 s window: -90, -90, -60. The median is -90, so the loud one alone does not enter. With two loud ones it does.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}, "2": {"team": 1, "state": ["alive"]}},
      "until_ms": 3000,
      "sightings": [{"t": 0, "id": 1, "rssi": -90}, {"t": 500, "id": 1, "rssi": -90}, {"t": 1000, "id": 1, "rssi": -60}, {"t": 0, "id": 2, "rssi": -90}, {"t": 500, "id": 2, "rssi": -60}, {"t": 1000, "id": 2, "rssi": -60}],
      "expect": [
        {"t": 500, "in": {"1": false, "2": false}},
        {"t": 1000, "in": {"1": false, "2": true}, "hill": {"team": 1, "state": ["rising"], "value": 3}},
        {"t": 2000, "in": {"1": false, "2": true}}
      ]
    },
    {
      "name": "silence for more than 4 s ends present and the circle",
      "why": "No advert for expiry_ms: present and the circle drop at once (strictly more than 4 s).",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
      "until_ms": 8000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 2000, "every_ms": 250, "rssi": [-60]}],
      "expect": [
        {"t": 6000, "present": {"1": true}, "in": {"1": true}},
        {"t": 6250, "present": {"1": false}, "in": {"1": false}},
        {"t": 8000, "hill": {"team": 0, "state": [], "value": 60}}
      ]
    },
    {
      "name": "a lone red player takes a neutral hill in ten seconds",
      "why": "capture_s 10: one net player builds 10 points a second, rising for red (not held) until 100, then held with no direction.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}},
      "until_ms": 12000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 12000, "every_ms": 250, "rssi": [-60]}],
      "expect": [
        {"t": 9750, "hill": {"team": 0, "state": ["rising"], "value": 98}},
        {"t": 10000, "hill": {"team": 0, "state": ["held"], "value": 100}},
        {"t": 12000, "hill": {"team": 0, "state": ["held"], "value": 100}}
      ]
    },
    {
      "name": "an arriving opponent contests at once, before the dwell",
      "why": "F440: contest is immediate. Blue arrives with one advert at -60 while red holds the point: the contested bit sets on the first tick, and blue is not yet present.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}, "2": {"team": 1, "state": ["alive"]}},
      "until_ms": 16000,
      "sightings": [{"t": 12000, "id": 2, "rssi": -60}],
      "series": [{"id": 1, "from_ms": 0, "to_ms": 16000, "every_ms": 250, "rssi": [-60]}],
      "expect": [
        {"t": 11750, "hill": {"team": 0, "state": ["held"], "value": 100}, "in": {"2": false}},
        {"t": 12000, "present": {"1": true, "2": false}, "hill": {"team": 0, "state": ["held", "contested"], "value": 100}, "in": {"1": true, "2": true}},
        {"t": 13000, "present": {"2": true}, "hill": {"team": 0, "state": ["held", "contested"], "value": 100}}
      ]
    },
    {
      "name": "tid 2 is refused, a dead player and a colour tid count for nothing",
      "why": "F82: tid 2 can never own a point. A down player and a colour tid contribute nothing either, so the hill stays neutral.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 2, "state": ["alive"]}, "2": {"team": 1, "state": []}, "3": {"team": 5, "state": ["alive"]}},
      "until_ms": 5000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 5000, "every_ms": 250, "rssi": [-60]}, {"id": 2, "from_ms": 0, "to_ms": 5000, "every_ms": 250, "rssi": [-60]}, {"id": 3, "from_ms": 0, "to_ms": 5000, "every_ms": 250, "rssi": [-60]}],
      "expect": [
        {"t": 1000, "hill": {"team": 255, "state": [], "value": 0}, "in": {"1": true}},
        {"t": 4000, "hill": {"team": 255, "state": [], "value": 0}}
      ]
    },
    {
      "name": "an even fight stalls and is contested",
      "why": "One red and one blue at once: net 0, contested, no direction, no progress.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}, "2": {"team": 1, "state": ["alive"]}},
      "until_ms": 5000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 5000, "every_ms": 250, "rssi": [-60]}, {"id": 2, "from_ms": 0, "to_ms": 5000, "every_ms": 250, "rssi": [-60]}],
      "expect": [
