        {"t": 8000, "present": {"1": false}}
      ]
    },
    {
      "name": "the sighting window keeps the last 64 adverts, the same bound on both sides",
      "why": "P-L1: 80 adverts arrive inside one 2 s window. Player 1 sends 40 low then 40 high (the last 64 hold 40 high: in the circle). Player 2 sends 50 low then 30 high (the last 64 hold 30 high: out). An unbounded window would read both as out.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}, "2": {"team": 1, "state": ["alive"]}},
