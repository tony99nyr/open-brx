    {
      "name": "an enemy-held point drains to neutral before it builds",
      "why": "Red takes the point, then only blue stands on it: it falls to 0 (red loses it), then rises for blue. Stealing is twice the work.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
