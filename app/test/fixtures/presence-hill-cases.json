      ]
    },
    {
      "name": "two against one converts at the one-player rate",
      "why": "Net is the leader minus the largest other team, not the sum. Two red against one blue is net 1: the same 10 points a second as one red alone, and contested.",
      "setup": {"threshold_dbm": -75, "dwell_ms": 800, "exit_band_db": 3, "exit_grace_ms": 4000, "expiry_ms": 4000, "sight_ms": 4000, "alpha": 0.35, "capture_s": 10, "net_cap": 3, "tick_ms": 250},
      "players": {"1": {"team": 0, "state": ["alive"]}, "2": {"team": 0, "state": ["alive"]}, "3": {"team": 1, "state": ["alive"]}},
      "until_ms": 6000,
      "series": [{"id": 1, "from_ms": 0, "to_ms": 6000, "every_ms": 250, "rssi": [-60]}, {"id": 2, "from_ms": 0, "to_ms": 6000, "every_ms": 250, "rssi": [-60]}, {"id": 3, "from_ms": 0, "to_ms": 6000, "every_ms": 250, "rssi": [-60]}],
      "expect": [
